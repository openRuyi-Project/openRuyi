diff --git a/libavformat/tests/seek.c b/libavformat/tests/seek.c
index 61219e8..987d839 100644
--- a/libavformat/tests/seek.c
+++ b/libavformat/tests/seek.c
@@ -66,6 +66,7 @@ int main(int argc, char **argv)
     int firstback=0;
     int frame_count = 1;
     int duration = 4;
+    int show_packet_pos_size = 1;
     int seekfirst_stream = -1;
 
     for(i=2; i<argc; i+=2){
@@ -80,6 +81,8 @@ int main(int argc, char **argv)
             frame_count = atoi(argv[i+1]);
         } else if(!strcmp(argv[i], "-duration")){
             duration = atoi(argv[i+1]);
+        } else if(!strcmp(argv[i], "-show_packet_pos_size")) {
+            show_packet_pos_size = atoi(argv[i+1]);
         } else if(!strcmp(argv[i], "-fastseek")) {
             if (atoi(argv[i+1])) {
                 ic->flags |= AVFMT_FLAG_FAST_SEEK;
@@ -132,7 +135,9 @@ int main(int argc, char **argv)
                 st= ic->streams[pkt.stream_index];
                 ts_str(dts_buf, pkt.dts, st->time_base);
                 ts_str(ts_buf,  pkt.pts, st->time_base);
-                printf("ret:%-10s st:%2d flags:%d dts:%s pts:%s pos:%7" PRId64 " size:%6d", ret_str(ret), pkt.stream_index, pkt.flags, dts_buf, ts_buf, pkt.pos, pkt.size);
+                printf("ret:%-10s st:%2d flags:%d dts:%s pts:%s", ret_str(ret), pkt.stream_index, pkt.flags, dts_buf, ts_buf);
+                if (show_packet_pos_size)
+                    printf(" pos:%7" PRId64 " size:%6d", pkt.pos, pkt.size);
                 av_packet_unref(&pkt);
             } else
                 printf("ret:%s", ret_str(ret)); // necessary to avoid trailing whitespace
diff --git a/tests/fate-run.sh b/tests/fate-run.sh
index a0aee71..2d1be42 100755
--- a/tests/fate-run.sh
+++ b/tests/fate-run.sh
@@ -274,6 +274,7 @@ enc_dec(){
     dec_opt_in=$7
     ffprobe_opts=$8
     twopass=$9
+    no_file_checksums="${10}"
     encfile="${outdir}/${test}.${enc_fmt_out}"
     decfile="${outdir}/${test}.out.${dec_fmt_out}"
     cleanfiles="$cleanfiles $decfile"
@@ -294,8 +295,10 @@ enc_dec(){
 
     ffmpeg -auto_conversion_filters -f $enc_fmt_in $DEC_OPTS -i $tsrcfile $ENC_OPTS $enc_opt_out $FLAGS \
         -f $enc_fmt_out -y $tencfile || return
-    do_md5sum $encfile
-    echo $(wc -c $encfile)
+    if [ -z "$no_file_checksums" ]; then
+        do_md5sum $encfile
+        echo $(wc -c $encfile)
+    fi
     ffmpeg -auto_conversion_filters $dec_opt_in $DEC_OPTS -i $tencfile $ENC_OPTS $dec_opt_out $FLAGS \
         -f $dec_fmt_out -y $tdecfile || return
     do_md5sum $decfile
@@ -315,6 +318,7 @@ transcode(){
     final_decode=$8
     enc_opt_in=$9
     final_encode_muxer="${10}"
+    no_file_checksums="${11}"
     test -z "$additional_input" || additional_input="$DEC_OPTS $additional_input"
     test -z "$final_encode_muxer" && final_encode_muxer="framecrc"
     encfile="${outdir}/${test}.${enc_fmt}"
@@ -323,8 +327,10 @@ transcode(){
     tencfile=$(target_path $encfile)
     ffmpeg -f $src_fmt $DEC_OPTS $enc_opt_in -i $tsrcfile $additional_input \
            $ENC_OPTS $enc_opt $FLAGS -f $enc_fmt -y $tencfile || return
-    do_md5sum $encfile
-    echo $(wc -c $encfile)
+    if [ -z "$no_file_checksums" ]; then
+        do_md5sum $encfile
+        echo $(wc -c $encfile)
+    fi
     ffmpeg $DEC_OPTS $final_decode -i $tencfile $ENC_OPTS $FLAGS $final_encode \
         -f $final_encode_muxer - || return
     test -z "$ffprobe_opts" || \
@@ -504,12 +510,18 @@ lavf_image2pipe(){
 }
 
 lavf_video(){
+    no_file_checksums="$3"
     t="${test#lavf-}"
     outdir="tests/data/lavf"
     file=${outdir}/lavf.$t
     test "$keep" -ge 1 || cleanfiles="$cleanfiles $file"
-    do_avconv $file -auto_conversion_filters $DEC_OPTS -f image2 -c:v pgmyuv -i $raw_src \
-              "$ENC_OPTS -metadata title=lavftest" -t 1 -qscale 10 $1 $2 || return
+    mkdir -p "$outdir"
+    run_avconv -auto_conversion_filters $DEC_OPTS -f image2 -c:v pgmyuv -i $raw_src \
+              "$ENC_OPTS -metadata title=lavftest" -t 1 -qscale 10 $1 $2 $target_path/$file || return
+    if [ -z "$no_file_checksums" ]; then
+        do_md5sum $file
+        echo $(wc -c $file)
+    fi
     do_avconv_crc $file -auto_conversion_filters $DEC_OPTS -i $target_path/$file $1
 }
 
