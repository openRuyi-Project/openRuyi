From dee6b94f8d07b8d768d23dfc3b9a46b33fe9dd12 Mon Sep 17 00:00:00 2001
From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Thu, 22 Oct 2026 19:01:33 +0800
Subject: [PATCH] client: serve the AK intermediate certificate locally in
 tests

Use the same PKI issuer fixture as the original network test, served by httptest, so offline builds retain certificate parsing, signature checks, and intermediate-chain retrieval coverage.

The fixture is downloaded from https://pki.goog/cloud_integrity/tpm_ek_intermediate_2.crt by the source service and installed in client/testdata before the test runs.

Upstream status: Not submitted; downstream hermetic test fixture.
---
 client/attest_network_test.go | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/client/attest_network_test.go b/client/attest_network_test.go
index 1cdbef0..2f37c42 100644
--- a/client/attest_network_test.go
+++ b/client/attest_network_test.go
@@ -3,6 +3,8 @@ package client
 import (
 	"crypto/x509"
 	"net/http"
+	"net/http/httptest"
+	"os"
 	"testing"
 
 	"github.com/google/go-tpm-tools/internal"
@@ -11,9 +13,16 @@ import (
 	"google.golang.org/protobuf/proto"
 )
 
-var externalClient = http.DefaultClient
-
 func TestNetworkFetchIssuingCertificate(t *testing.T) {
+	intermediate, err := os.ReadFile("testdata/tpm_ek_intermediate_2.crt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write(intermediate)
+	}))
+	t.Cleanup(server.Close)
+
 	attestBytes := test.COS85Nonce9009
 	att := &pb.Attestation{}
 	if err := proto.Unmarshal(attestBytes, att); err != nil {
@@ -25,7 +34,10 @@ func TestNetworkFetchIssuingCertificate(t *testing.T) {
 		t.Fatalf("Error parsing AK Cert: %v", err)
 	}
 
-	certChain, err := internal.GetAKIntermediateCerts(akCert, externalClient)
+	// Retain the real signed AK certificate and its issuer, but serve the
+	// issuer locally so the test does not depend on Google's PKI being online.
+	akCert.IssuingCertificateURL = []string{server.URL}
+	certChain, err := internal.GetAKIntermediateCerts(akCert, server.Client())
 	if err != nil {
 		t.Error(err)
 	}
-- 
