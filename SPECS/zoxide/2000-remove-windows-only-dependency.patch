From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kimmy <yucheng.or@isrc.iscas.ac.cn>
Date: Mon, 23 Nov 2026 12:00:00 +0800
Subject: [PATCH] Remove the Windows-only which dependency

The Linux build does not compile this target-specific dependency. Removing
it keeps the offline Cargo registry closure limited to the Linux target.

---
 Cargo.toml | 2 --
 1 file changed, 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -32,8 +32,6 @@
 serde = { version = "1.0.116", features = ["derive"] }
 time = { version = "0.3.47", default-features = false, features = ["parsing", "macros", "std"] }
 
-[target.'cfg(windows)'.dependencies]
-which = "8.0.2"
 
 [build-dependencies]
 clap = { version = "4.3.0", features = ["derive"] }
 clap_complete = "4.5.50"
--
2.39.5
