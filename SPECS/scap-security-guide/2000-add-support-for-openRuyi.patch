+    rules:
+      - package_firewalld_installed
+      - package_firewalld_installed.severity=high
+      - service_firewalld_enabled
+      - service_firewalld_enabled.severity=high
+      - service_nftables_disabled
+      - service_nftables_disabled.severity=high
+
+  - id: 5.1_selinux_enforcing
+    title: Ensure SELinux is Enforcing
+    levels:
+      - base
+    status: automated
+    rules:
+      - package_libselinux_installed
