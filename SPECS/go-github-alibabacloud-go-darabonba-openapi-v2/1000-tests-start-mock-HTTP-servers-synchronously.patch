 	mux.Handle("/", &mockHandler{content: "json"})
-	var server *http.Server
-	server = &http.Server{
-		Addr:         ":9001",
-		WriteTimeout: time.Second * 4,
-		Handler:      mux,
-	}
-	go server.ListenAndServe()
