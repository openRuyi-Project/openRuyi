From 0bc950536a911669356ee685b16dce788f564634 Mon Sep 17 00:00:00 2001
From: sirzooro <daniel@poradnik-webmastera.com>
Date: Mon, 9 Jun 2025 20:15:12 +0200
Subject: [PATCH] Copy PaddingSize from rtp.Packet to Header

---
 track_local_static.go      | 5 +++++
 track_local_static_test.go | 1 +
 2 files changed, 6 insertions(+)

--- a/track_local_static.go
+++ b/track_local_static.go
@@ -165,6 +165,11 @@
 	for _, b := range s.bindings {
 		p.Header.SSRC = uint32(b.ssrc)
 		p.Header.PayloadType = uint8(b.payloadType)
+		// b.writeStream.WriteRTP below expects header and payload separately, so value of Packet.PaddingSize
+		// would be lost. Copy it to Packet.Header.PaddingSize to avoid that problem.
+		if p.PaddingSize != 0 && p.Header.PaddingSize == 0 {
+			p.Header.PaddingSize = p.PaddingSize
+		}
 		if _, err := b.writeStream.WriteRTP(&p.Header, p.Payload); err != nil {
 			writeErrs = append(writeErrs, err)
 		}
--- a/track_local_static_test.go
+++ b/track_local_static_test.go
@@ -293,6 +293,7 @@
 			assert.NoError(t, e)
 			assert.True(t, p.Padding)
 			assert.Equal(t, p.PaddingSize, byte(255))
+			assert.Equal(t, p.Header.PaddingSize, byte(255))
 		}
 
 		onTrackFiredFunc()
