From dc9c13a7446403738dedcbdc3d49df0d07f59eeb Mon Sep 17 00:00:00 2001
From: cl2t <91820982+cl2t@users.noreply.github.com>
Date: Wed, 9 Sep 2026 19:56:06 +0800
Subject: [PATCH] Honor short mode in tests requiring DNS or a MongoDB server

SRV fixtures resolve test.build.10gen.cc using external DNS. The heartbeat timeout test connects to localhost:27017. Skip those cases in the upstream short test mode while retaining the remaining URI, topology and authentication tests. Full-mode test bodies and production behavior are unchanged.

Signed-off-by: cl2t <91820982+cl2t@users.noreply.github.com>
---
 mongo/options/clientoptions_test.go           |  3 +++
 .../driver/connstring/connstring_spec_test.go |  4 ++++
 .../topology/polling_srv_records_test.go      | 20 +++++++++++++++++++
 x/mongo/driver/topology/server_test.go        |  4 ++++
 x/mongo/driver/topology/topology_test.go      |  3 +++
 5 files changed, 34 insertions(+)

diff --git a/mongo/options/clientoptions_test.go b/mongo/options/clientoptions_test.go
index f85a112..f97a905 100644
--- a/mongo/options/clientoptions_test.go
+++ b/mongo/options/clientoptions_test.go
@@ -626,6 +626,9 @@ func TestClientOptions(t *testing.T) {
 
 		for _, tc := range testCases {
 			t.Run(tc.name, func(t *testing.T) {
+				if testing.Short() && (tc.name == "srvServiceName" || tc.name == "srvMaxHosts") {
+					t.Skip("requires external MongoDB SRV DNS records")
+				}
 				result := Client().ApplyURI(tc.uri)
 
 				// Manually add the URI and ConnString to the test expectations to avoid adding them in each test
diff --git a/x/mongo/driver/connstring/connstring_spec_test.go b/x/mongo/driver/connstring/connstring_spec_test.go
index aea68eb..0cec05e 100644
--- a/x/mongo/driver/connstring/connstring_spec_test.go
+++ b/x/mongo/driver/connstring/connstring_spec_test.go
@@ -119,6 +119,10 @@ func runTest(t *testing.T, filename string, test testCase, warningsError bool) {
 			}
 		}
 
+		if testing.Short() && strings.Contains(test.URI, "test.build.10gen.cc") {
+			t.Skip("requires external MongoDB SRV DNS records")
+		}
+
 		cs, err := connstring.ParseAndValidate(test.URI)
 		// Since we don't have warnings in Go, we return warnings as errors.
 		//
