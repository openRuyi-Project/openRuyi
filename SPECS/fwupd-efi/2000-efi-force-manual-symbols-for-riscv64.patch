From 1f9859bf300a078bba64a61d3e9338af0b0e1e45 Mon Sep 17 00:00:00 2001
From: Xiang W <wangxiang@iscas.ac.cn>
Date: Fri, 23 Oct 2026 16:19:16 +0800
Subject: [PATCH] efi: force manual symbols for riscv64

objcopy >= 2.42 still produces a malformed EFI binary on RISC-V.
Always use the binary + manual symbols path so the output is valid.

Signed-off-by: Xiang W <wangxiang@iscas.ac.cn>
---
 efi/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/efi/meson.build b/efi/meson.build
index 065523b..b35c8ea 100644
--- a/efi/meson.build
+++ b/efi/meson.build
@@ -92,7 +92,7 @@ endif
 # older objcopy for Aarch64, ARM32 and RISC-V are not EFI capable.
 # Use 'binary' instead, and add required symbols manually.
 if ( host_cpu == 'arm'
-  or (host_cpu == 'riscv64'     and (objcopy_version.version_compare ('< 2.42') or coff_header_in_crt0))
+  or host_cpu == 'riscv64'
   or (host_cpu == 'aarch64'     and (objcopy_version.version_compare ('< 2.38') or coff_header_in_crt0 or uswid.found()))
   or (host_cpu == 'loongarch64' and (objcopy_version.version_compare ('< 2.41') or coff_header_in_crt0)) )
   objcopy_manualsymbols = true
-- 
2.47.3

