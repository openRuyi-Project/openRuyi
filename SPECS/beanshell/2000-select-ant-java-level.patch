From b4dc89a7d06fb21c54d4bc18f1aea29ff9c83cec Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Tue, 3 Nov 2026 23:23:59 +0800
Subject: [PATCH] Allow selecting the Java level for Ant builds

The compiler and test targets specify Java 6, which current javac no
longer accepts. Honor the standard Ant source and target properties
for all three targets and retain the existing defaults.

Upstream-Status: Downstream (2.x Ant build)
Upstream: https://github.com/beanshell/beanshell/blob/2.1.1/build.xml
Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 build.xml | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/build.xml b/build.xml
index b0044140..2efde4a7 100644
--- a/build.xml
+++ b/build.xml
@@ -19,6 +19,8 @@
 	<property name="ant.build.javac.target" value="1.6" />
 	<property name="ant.build.javac.source" value="1.6" />
 	<property name="version" value="2.1.1"/>
+	<property name="ant.build.javac.source" value="1.6"/>
+	<property name="ant.build.javac.target" value="1.6"/>
 	<property name="deprecation" value="on"/>
 	<property name="Specification-Title" value="BeanShell" />
 	<property name="Specification-Version" value="${version}" />
@@ -178,8 +180,8 @@
 			debug="on"
 			includes="**/*.java"
 			excludes="${excludes},**/bak/**"
-			source="1.6"
-			target="1.6"
+			source="${ant.build.javac.source}"
+			target="${ant.build.javac.target}"
 		>
 			<classpath>
 				<fileset refid="lib-fileset"/>
@@ -213,8 +215,8 @@
 			debug="on"
 			includes="**/*.java"
 			excludes="${excludes},**/bak/**"
-			source="1.6"
-			target="1.6"
+			source="${ant.build.javac.source}"
+			target="${ant.build.javac.target}"
 		>
 			<classpath>
 				<fileset refid="lib-fileset"/>
@@ -255,7 +257,7 @@
 			 destdir="${javadoc-dir}"
 			 author="true"
 			 version="true"
-			 source="1.6"
+			 source="${ant.build.javac.source}"
 			 use="true"
 			 windowtitle="BeanShell ${version}"
 			 doctitle="&lt;h1&gt;BeanShell ${version}&lt;h1&gt;"
@@ -680,8 +682,8 @@
 				destdir="${build-dir}"
 				debug="on"
 				debuglevel="lines,vars,source"
-				source="1.6"
-				target="1.6"
+				source="${ant.build.javac.source}"
+				target="${ant.build.javac.target}"
 			  >
 		 <classpath>
 			<path refid="test-classpath"/>
-- 
2.54.0

