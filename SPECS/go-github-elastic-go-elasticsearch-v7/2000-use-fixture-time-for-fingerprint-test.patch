From: cl2t <yihong.or@isrc.iscas.ac.cn>
Date: Tue, 15 Sep 2026 15:47:56 +0800
Subject: [PATCH] test: verify certificate fingerprints within fixture validity

The embedded certificate expires independently of the code under test.
Use a test-local TLS verification time inside its validity window so the
negative trust check continues to require UnknownAuthorityError and the
positive fingerprint check still checks the original certificate digest.
Do not change production TLS verification.

Signed-off-by: cl2t <yihong.or@isrc.iscas.ac.cn>
---
--- a/elasticsearch_internal_test.go
+++ b/elasticsearch_internal_test.go
@@ -36,6 +36,7 @@
 	"regexp"
 	"strings"
 	"testing"
+	"time"
 
 	"github.com/elastic/go-elasticsearch/v7/esapi"
 	"github.com/elastic/go-elasticsearch/v7/estransport"
@@ -842,9 +843,20 @@
 
 	defer server.Close()
 
+	// Certificate trust and fingerprint checks must not depend on the wall clock.
+	leaf, err := x509.ParseCertificate(cert.Certificate[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.TLSClientConfig = &tls.Config{
+		RootCAs: x509.NewCertPool(),
+		Time:    func() time.Time { return leaf.NotBefore.Add(time.Hour) },
+	}
 	config := Config{
 		Addresses:    []string{server.URL},
 		DisableRetry: true,
+		Transport:    transport,
 	}
 
 	// Without certificate and authority, client should fail on TLS
