From 54f2774444c9ab11cf9f468b24c3c7f70255c862 Mon Sep 17 00:00:00 2001
From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Fri, 23 Oct 2026 16:22:12 +0800
Subject: [PATCH] Report development version in GOPATH builds

GOPATH builds contain Go build information but no module record. Use the development-version fallback when the gofumpt module cannot be found, preserving diagnose output and its tests without changing golden fixtures.

Original-patch-commit: 47ef1e64ce10151dc38f96a4ce592499e101d391
---
 internal/version/version.go | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/internal/version/version.go b/internal/version/version.go
index e136235002bb3d2318e6c0068ea87a3d700f0222..601e6c7d7218166f4937861327d45821c53b8335 100644
--- a/internal/version/version.go
+++ b/internal/version/version.go
@@ -33,7 +33,8 @@ func gofumptVersion() string {
 	// so we cannot assume it is the main module in the build.
 	mod := findModule(info, ourModulePath)
 	if mod == nil {
-		return "(module not found)"
+		// GOPATH builds do not record module metadata.
+		return "(devel)"
 	}
 	if mod.Replace != nil {
 		mod = mod.Replace
