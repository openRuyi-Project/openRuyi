From 27e9e703a97669f00ad37a2b84b6c91085f051ce Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 18 Nov 2026 22:22:12 +0800
Subject: [PATCH] util.c: only set O_DIRECT on block devices in dev_open()

dev_open() unconditionally sets O_DIRECT even when opening regular
image files. On regular files, ioctl(BLKSSZGET) returns ENOTTY so
init_afd() falls back to a 512-byte block size, causing 512-byte
O_DIRECT reads such as the bitmap superblock probe in load_super1()
to fail with EINVAL on filesystems or 4Kn backing storage requiring
4096-byte O_DIRECT I/O alignment.

Keep O_DIRECT for block devices (including mknod targets in the
major:minor branch) and omit it for non-block files such as regular
disk images.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 util.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/util.c b/util.c
index 8b614ce8..7086c431 100644
--- a/util.c
+++ b/util.c
@@ -1130,17 +1130,28 @@ int dev_open(char *dev, int flags)
 
 	if (!dev)
 		return -1;
-	flags |= O_DIRECT;
 
 	if (get_maj_min(dev, &major, &minor)) {
+		flags |= O_DIRECT;
 		snprintf(devname, sizeof(devname), "/dev/.tmp.md.%d:%d:%d",
 			 (int)getpid(), major, minor);
 		if (mknod(devname, S_IFBLK|0600, makedev(major, minor)) == 0) {
 			fd = open(devname, flags);
 			unlink(devname);
 		}
-	} else
+	} else {
+		struct stat stb;
+
+		/*
+		 * Only use O_DIRECT on block devices. Offline commands such as
+		 * --examine or --dump may open regular disk image files where
+		 * BLKSSZGET is unsupported and 512-byte fallback reads fail
+		 * with EINVAL on 4K-aligned filesystems/storage.
+		 */
+		if (stat(dev, &stb) == 0 && S_ISBLK(stb.st_mode))
+			flags |= O_DIRECT;
 		fd = open(dev, flags);
+	}
 	return fd;
 }
 
