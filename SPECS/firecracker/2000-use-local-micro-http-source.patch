From 646712e8889082604a71dd170f5328f34d9b7534 Mon Sep 17 00:00:00 2001
From: Jvle <keke.oerv@isrc.iscas.ac.cn>
Date: Tue, 3 Nov 2026 11:27:26 +0800
Subject: [PATCH] Build: Use packaged micro-http source

Firecracker references micro-http through a Git dependency, which would make Cargo fetch source during the package build. Package the pinned micro-http revision as a verified Source archive and extract it under deps/micro-http, then point both workspace consumers at that local copy so the build stays reproducible and works offline.

Signed-off-by: Jvle <keke.oerv@isrc.iscas.ac.cn>
---
 src/firecracker/Cargo.toml | 2 +-
 src/vmm/Cargo.toml         | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/firecracker/Cargo.toml b/src/firecracker/Cargo.toml
index 67c84c7..489c911 100644
--- a/src/firecracker/Cargo.toml
+++ b/src/firecracker/Cargo.toml
@@ -25,7 +25,7 @@ displaydoc = "0.2.6"
 event-manager = "0.4.2"
 libc = "0.2.186"
 log-instrument = { path = "../log-instrument", optional = true }
-micro_http = { git = "https://github.com/firecracker-microvm/micro-http" }
+micro_http = { path = "../../deps/micro-http" }
 serde = { version = "1.0.228", features = ["derive"] }
 serde_derive = "1.0.136"
 serde_json = "1.0.150"
diff --git a/src/vmm/Cargo.toml b/src/vmm/Cargo.toml
index 2d4ae76..95a1c25 100644
--- a/src/vmm/Cargo.toml
+++ b/src/vmm/Cargo.toml
@@ -40,7 +40,7 @@ linux-loader = { version = "0.14.0", features = ["bzimage"] }
 log = { version = "0.4.31", features = ["std", "serde"] }
 log-instrument = { path = "../log-instrument", optional = true }
 memfd = "0.6.5"
-micro_http = { git = "https://github.com/firecracker-microvm/micro-http" }
+micro_http = { path = "../../deps/micro-http" }
 semver = { version = "1.0.28", features = ["serde"] }
 serde = { version = "1.0.228", features = ["derive", "rc"] }
 serde_json = "1.0.150"
-- 
2.43.0

