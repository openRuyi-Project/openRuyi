+                "DEFAULT": read_root_config(
+                    "buckal",
+                    "linux_host_rust_target",
+                    "x86_64-unknown-linux-gnu",
+                ),
+            }),
             "prelude//os/constraints:macos": "aarch64-apple-darwin",
             "prelude//os/constraints:windows": "x86_64-pc-windows-msvc",
