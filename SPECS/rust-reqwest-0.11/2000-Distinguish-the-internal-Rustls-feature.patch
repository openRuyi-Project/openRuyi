From 7ea267f52e80216471a0271cd63e33bec3ce41d7 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 11 Nov 2026 01:22:21 +0800
Subject: [PATCH] Rename the internal Rustls feature to avoid RPM capability 
 collisions.

The private __rustls feature and the optional rustls dependency normalize
to the same RPM feature name. Keep them distinct while preserving the
public TLS feature selections and their dependency graph.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 Cargo.toml               |  8 +++----
 Cargo.toml.orig          |  8 +++----
 src/async_impl/client.rs | 28 ++++++++++++------------
 src/blocking/client.rs   | 10 ++++-----
 src/connect.rs           | 24 ++++++++++-----------
 src/tls.rs               | 46 ++++++++++++++++++++--------------------
 tests/client.rs          |  6 +++---
 tests/redirect.rs        |  2 +-
 8 files changed, 66 insertions(+), 66 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 6a6a648..8e45fd0 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -153,7 +153,7 @@ version = "2.2"
 
 [features]
 __internal_proxy_sys_no_cache = []
-__rustls = [
+internal-rustls = [
     "hyper-rustls",
     "tokio-rustls",
     "rustls",
@@ -210,14 +210,14 @@ native-tls-vendored = [
     "native-tls-crate/vendored",
 ]
 rustls-tls = ["rustls-tls-webpki-roots"]
-rustls-tls-manual-roots = ["__rustls"]
+rustls-tls-manual-roots = ["internal-rustls"]
 rustls-tls-native-roots = [
     "rustls-native-certs",
-    "__rustls",
+    "internal-rustls",
 ]
 rustls-tls-webpki-roots = [
     "webpki-roots",
-    "__rustls",
+    "internal-rustls",
 ]
 socks = ["tokio-socks"]
 stream = [
diff --git a/Cargo.toml.orig b/Cargo.toml.orig
index eb0b2c1..3e30c02 100644
--- a/Cargo.toml.orig
+++ b/Cargo.toml.orig
@@ -39,9 +39,9 @@ native-tls-alpn = ["native-tls", "native-tls-crate/alpn"]
 native-tls-vendored = ["native-tls", "native-tls-crate/vendored"]
 
 rustls-tls = ["rustls-tls-webpki-roots"]
-rustls-tls-manual-roots = ["__rustls"]
-rustls-tls-webpki-roots = ["webpki-roots", "__rustls"]
-rustls-tls-native-roots = ["rustls-native-certs", "__rustls"]
+rustls-tls-manual-roots = ["internal-rustls"]
+rustls-tls-webpki-roots = ["webpki-roots", "internal-rustls"]
+rustls-tls-native-roots = ["rustls-native-certs", "internal-rustls"]
 
 blocking = ["futures-util/io", "tokio/sync"]
 
@@ -76,7 +76,7 @@ __tls = ["dep:rustls-pemfile"]
 
 # Enables common rustls code.
 # Equivalent to rustls-tls-manual-roots but shorter :)
-__rustls = ["hyper-rustls", "tokio-rustls", "rustls", "__tls"]
+internal-rustls = ["hyper-rustls", "tokio-rustls", "rustls", "__tls"]
 
 # When enabled, disable using the cached SYS_PROXIES.
 __internal_proxy_sys_no_cache = []
