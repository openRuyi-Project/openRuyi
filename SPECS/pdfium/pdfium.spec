%description
PDFium parses PDF documents, renders pages to bitmaps, and exposes
interfaces for working with text, forms and annotations.

%package        devel
Summary:        Public C interface for PDFium
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    devel
C API declarations and linker files for embedding PDFium.

%prep
%autosetup -p1
# FastFloat and Dragonbox instantiate header code under their common Boost license.
cp -p %{_licensedir}/fast_float/LICENSE-BOOST FastFloat-BOOST.txt
cp -p %{_licensedir}/dragonbox-devel/LICENSE-Boost Dragonbox-BOOST.txt
cp -p %{_licensedir}/abseil-cpp/LICENSE Abseil-LICENSE.txt
mkdir -p build
tar -xf %{SOURCE1} -C build --strip-components=1
mkdir -p third_party/test_fonts
tar -xf %{SOURCE2} -C third_party/test_fonts --strip-components=1
tar -xf %{SOURCE3} -C third_party/test_fonts
# Chromium's target templates otherwise add its bundled libc++ modules to
# every Clang target, including builds against the system libstdc++.
sed -i 's/use_libcxx_modules = is_clang/use_libcxx_modules = false/' build/config/BUILDCONFIG.gn
# Generated by gclient from the standalone Linux settings in PDFium DEPS.
cat >build/config/gclient_args.gni <<'GCLIENT'
android_ndk_version = "2@30.0.16138531"
build_with_chromium = false
checkout_android = false
checkout_libpng = false
checkout_skia = false
GCLIENT
sed -i 's|^script_executable = .*|script_executable = "%{python3}"|' .gn
mkdir -p third_party/{icu,abseil-cpp,dragonbox,fast_float}
cat >third_party/icu/BUILD.gn <<'ICU'
import("//build/config/linux/pkg_config.gni")
pkg_config("system_icu") {
  packages = [ "icu-uc" ]
  defines = [ "USE_SYSTEM_ICUUC" ]
}
group("icuuc") {
  public_configs = [ ":system_icu" ]
}
ICU

cat >third_party/abseil-cpp/BUILD.gn <<'ABSEIL'
import("//build/config/linux/pkg_config.gni")
pkg_config("absl_system") {
  defines = [ "USE_SYSTEM_ABSEIL" ]
  packages = [ "absl_cleanup", "absl_flat_hash_set", "absl_inlined_vector" ]
}
group("absl") {
  public_configs = [ ":absl_system" ]
}
ABSEIL

cat >third_party/dragonbox/BUILD.gn <<'HEADERS'
config("system_headers") {
  defines = [ "USE_SYSTEM_DRAGONBOX" ]
}
group("dragonbox") {
  public_configs = [ ":system_headers" ]
}
HEADERS
cat >third_party/fast_float/BUILD.gn <<'HEADERS'
config("system_headers") {
  defines = [ "USE_SYSTEM_FAST_FLOAT" ]
}
group("fast_float") {
  public_configs = [ ":system_headers" ]
}
HEADERS

# PDFium does not promise an ABI across snapshot revisions.
sed -i '/^  output_name = "pdfium"$/a\  output_extension = "so.%{version}"' BUILD.gn

%build
export PDFIUM_TARGET_TRIPLE="$(%{_libdir}/llvm24/bin/clang -dumpmachine)"
%ifarch riscv64
# Native Clang needs the openRuyi target to find the system libstdc++ headers and libraries.
sed -i "s/--target=riscv64-linux-gnu/--target=$PDFIUM_TARGET_TRIPLE/" build/config/compiler_cpu_abi.gn
%endif
sed -i -e 's/_dir = "x86_64-unknown-linux-gnu"/_dir = getenv("PDFIUM_TARGET_TRIPLE")/' \
    -e 's/_dir = "riscv64-unknown-linux-gnu"/_dir = getenv("PDFIUM_TARGET_TRIPLE")/' build/config/clang/BUILD.gn
mkdir -p out/Release
cat >out/Release/args.gn <<'ARGS'
is_debug = false
is_component_build = true
is_clang = true
clang_base_path = "%{_libdir}/llvm24"
clang_use_chrome_plugins = false
use_sysroot = false
use_custom_libcxx = false
use_custom_libcxx_for_host = false
treat_warnings_as_errors = false
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_use_skia = false
pdf_use_partition_alloc = false
pdf_bundle_freetype = false
use_gio = false
use_glib = false
use_system_freetype = true
use_system_libjpeg = true
use_system_harfbuzz = true
use_system_lcms2 = true
use_system_libopenjpeg2 = true
use_system_libpng = true
use_system_zlib = true
ARGS
gn gen out/Release --root-target=//:distribution_tests --root-pattern=//:distribution_tests
ninja -C out/Release -j%{_smp_build_ncpus} pdfium pdfium_unittests pdfium_embeddertests

%install
install -d %{buildroot}%{_libdir} %{buildroot}%{_includedir}/pdfium/public
install -pm 0755 out/Release/libpdfium.so.%{version} %{buildroot}%{_libdir}/
ln -s libpdfium.so.%{version} %{buildroot}%{_libdir}/libpdfium.so
install -pm 0644 public/*.h %{buildroot}%{_includedir}/pdfium/public/
install -d %{buildroot}%{_includedir}/pdfium/public/cpp
install -pm 0644 public/cpp/*.h %{buildroot}%{_includedir}/pdfium/public/cpp/
install -d %{buildroot}%{_libdir}/pkgconfig
cat >%{buildroot}%{_libdir}/pkgconfig/pdfium.pc <<'PC'
prefix=%{_prefix}
libdir=%{_libdir}
includedir=%{_includedir}/pdfium

Name: PDFium
Description: Public PDFium C API
Version: %{version}
Libs: -L${libdir} -lpdfium
Cflags: -I${includedir} -I${includedir}/public
PC

%check
# Run the upstream unit and embedder suites with their pinned test fonts.
out/Release/pdfium_unittests
# Pixel snapshots use PDFium's patched FreeType 2.14.3-85; system FreeType
# 2.14.3 produces different glyph-edge coverage in these five cases.
pdfium_pixel_tests="FPDFProgressiveRenderEmbedderTest.RenderHighlightWithColorScheme:FPDFProgressiveRenderEmbedderTest.RenderHighlightWithColorSchemeAndConvertFillToStroke:FPDFAnnotEmbedderTest.ModifyRectQuadpointsWithAP:FPDFEditEmbedderTest.SetPositionsVertical:FPDFViewEmbedderTest.RenderAnnotsGrayScale"
# Font-subset sizes assume HarfBuzz 14.3.1, while the system uses 14.0.0.
# Exact serialized byte lengths also differ with the system zlib-ng.
pdfium_size_tests="CPDFFontSubsetterTest.MultipleFontsMultipleTexts:FPDFSaveWithFontSubsetEmbedderTest.SaveWithoutSubsetWithNewText:FPDFSaveWithFontSubsetEmbedderTest.SaveWithSubsetWithNewText"
out/Release/pdfium_embeddertests --gtest_filter="-${pdfium_pixel_tests}:${pdfium_size_tests}"

