From ae41ed090d32240bc9c1d236b0738dd1b9075f49 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Thu, 5 Nov 2026 15:01:34 +0800
Subject: [PATCH] Build upstream tests with system GoogleTest and simdutf.

Use distribution test libraries through pkg-config and their installed headers. Add a root target for the shared library and upstream unit and embedder tests without pulling in unrelated fuzzing targets.

Account for temporary const RetainPtr conversions in libstdc++ set lookups when checking retain and release counts in the upstream SetContains test.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 BUILD.gn                                      |  10 +-
 core/fxcrt/retain_ptr_unittest.cpp            |  12 +-
 testing/embedder_test.cpp                     |   2 +-
 testing/gmock/include/gmock/gmock-actions.h   |   2 +-
 .../gmock/gmock-generated-function-mockers.h  |   2 +-
 testing/gmock/include/gmock/gmock-matchers.h  |   2 +-
 testing/gmock/include/gmock/gmock.h           |   2 +-
 .../gtest/include/gtest/gtest-death-test.h    |   2 +-
 testing/gtest/include/gtest/gtest-message.h   |   2 +-
 .../gtest/include/gtest/gtest-param-test.h    |   2 +-
 testing/gtest/include/gtest/gtest-spi.h       |   2 +-
 testing/gtest/include/gtest/gtest.h           |   2 +-
 testing/gtest/include/gtest/gtest_prod.h      |   2 +-
 third_party/googletest/BUILD.gn               | 173 +-----------------
 third_party/simdutf/BUILD.gn                  |  13 ++
 15 files changed, 48 insertions(+), 182 deletions(-)
 create mode 100644 third_party/simdutf/BUILD.gn

diff --git a/BUILD.gn b/BUILD.gn
index cf5541a..f684a4d 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -386,7 +386,6 @@ test("pdfium_embeddertests") {
     "//testing/gmock",
     "//testing/gtest",
   ]
-  include_dirs = [ "testing/gmock/include" ]
   configs += [ ":pdfium_core_config" ]
 
   if (is_android) {
@@ -458,3 +457,12 @@ if (current_toolchain == default_toolchain) {
 
   write_file("$root_build_dir/gn_logs.txt", _lines)
 }
+
+group("distribution_tests") {
+  testonly = true
+  deps = [
+    ":pdfium",
+    ":pdfium_unittests",
+    ":pdfium_embeddertests",
+  ]
+}
diff --git a/core/fxcrt/retain_ptr_unittest.cpp b/core/fxcrt/retain_ptr_unittest.cpp
index d8be056..4bcc1fe 100644
--- a/core/fxcrt/retain_ptr_unittest.cpp
+++ b/core/fxcrt/retain_ptr_unittest.cpp
@@ -494,16 +494,18 @@ TEST(RetainPtr, SetContains) {
   EXPECT_EQ(the_set.end(), the_set.find(ptr2));
   EXPECT_TRUE(pdfium::Contains(the_set, ptr1));
   EXPECT_FALSE(pdfium::Contains(the_set, ptr2));
-#if !BUILDFLAG(IS_WIN) &&                                       \
-    (defined(ADDRESS_SANITIZER) || defined(MEMORY_SANITIZER) || \
-     defined(UNDEFINED_SANITIZER))
+  // libstdc++ compares the stored const RetainPtr with the mutable lookup key,
+  // creating a temporary const RetainPtr for each unsuccessful lookup.
+#if defined(__GLIBCXX__) || \
+    (!BUILDFLAG(IS_WIN) && \
+     (defined(ADDRESS_SANITIZER) || defined(MEMORY_SANITIZER) || \
+      defined(UNDEFINED_SANITIZER)))
   constexpr int kExpectedObj2RetainCount = 4;
   constexpr int kExpectedObj2ReleaseCount = 2;
 #else
   constexpr int kExpectedObj2RetainCount = 2;
   constexpr int kExpectedObj2ReleaseCount = 0;
-#endif  // !BUILDFLAG(IS_WIN) && (defined(ADDRESS_SANITIZER) ||
-        // defined(MEMORY_SANITIZER))
+#endif
   EXPECT_EQ(kExpectedObj2RetainCount, obj2.retain_count());
   EXPECT_EQ(kExpectedObj2ReleaseCount, obj2.release_count());
 }
