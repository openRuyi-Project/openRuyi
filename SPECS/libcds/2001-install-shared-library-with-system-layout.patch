From ff3839d6055a5129f510a6124cf36f289160fcae Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Thu, 5 Nov 2026 21:30:23 +0800
Subject: [PATCH] Install the shared library with system directory conventions

Allow excluding the static archive without exporting an unavailable
CMake target. Use GNUInstallDirs and provide pkg-config metadata so
non-CMake consumers use the same public DCAS compiler options.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 CMakeLists.txt | 28 ++++++++++++++++++++++++----
 libcds.pc.in   | 10 ++++++++++
 2 files changed, 34 insertions(+), 4 deletions(-)
 create mode 100644 libcds.pc.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d97ee07..34ff97a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,8 @@ include(TargetArch)
 include(CheckIncludeFileCXX)
 
 project(cds)
+include(GNUInstallDirs)
+option(BUILD_STATIC "Build the static library" ON)
 
 set(PROJECT_VERSION 2.3.3)
 
@@ -169,27 +171,40 @@ if(MINGW)
     set_target_properties(${CDS_SHARED_LIBRARY} PROPERTIES DEFINE_SYMBOL CDS_BUILD_LIB)
 endif()
 
+if(BUILD_STATIC)
 add_library(${CDS_STATIC_LIBRARY} STATIC ${SOURCES})
 set_target_properties(${CDS_STATIC_LIBRARY} PROPERTIES DEBUG_POSTFIX "_d")
 if(MINGW)
     target_compile_definitions(${CDS_STATIC_LIBRARY} PRIVATE CDS_BUILD_STATIC_LIB)
 endif()
 
+endif()
+
 target_link_libraries(${CDS_SHARED_LIBRARY} PRIVATE ${CMAKE_THREAD_LIBS_INIT})
+if(BUILD_STATIC)
 target_link_libraries(${CDS_STATIC_LIBRARY} PRIVATE ${CMAKE_THREAD_LIBS_INIT})
+endif()
 target_include_directories(${CDS_SHARED_LIBRARY} INTERFACE "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}>"
                                                             $<INSTALL_INTERFACE:include>)
+if(BUILD_STATIC)
 target_include_directories(${CDS_STATIC_LIBRARY} INTERFACE "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}>"
                                                             $<INSTALL_INTERFACE:include>)
+endif()
 target_compile_options(${CDS_SHARED_LIBRARY} PUBLIC "${LIBCDS_PUBLIC_CXX_FLAGS}")
+if(BUILD_STATIC)
 target_compile_options(${CDS_STATIC_LIBRARY} PUBLIC "${LIBCDS_PUBLIC_CXX_FLAGS}")
+endif()
 target_compile_options(${CDS_SHARED_LIBRARY} PRIVATE "${LIBCDS_PRIVATE_CXX_FLAGS}")
+if(BUILD_STATIC)
 target_compile_options(${CDS_STATIC_LIBRARY} PRIVATE "${LIBCDS_PRIVATE_CXX_FLAGS}")
+endif()
 
-install(TARGETS ${CDS_SHARED_LIBRARY} EXPORT LibCDSConfig LIBRARY DESTINATION lib${LIB_SUFFIX} COMPONENT ${LIBRARIES_COMPONENT} NAMELINK_SKIP RUNTIME DESTINATION lib${LIB_SUFFIX})
-install(TARGETS ${CDS_SHARED_LIBRARY} EXPORT LibCDSConfig LIBRARY DESTINATION lib${LIB_SUFFIX} COMPONENT ${HEADERS_COMPONENT} NAMELINK_ONLY)
-install(TARGETS ${CDS_STATIC_LIBRARY} EXPORT LibCDSConfig DESTINATION lib${LIB_SUFFIX} COMPONENT ${LIBRARIES_COMPONENT})
-install(EXPORT LibCDSConfig FILE LibCDSConfig.cmake NAMESPACE LibCDS:: DESTINATION lib/cmake/LibCDS)
+install(TARGETS ${CDS_SHARED_LIBRARY} EXPORT LibCDSConfig LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT ${LIBRARIES_COMPONENT} NAMELINK_SKIP RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(TARGETS ${CDS_SHARED_LIBRARY} EXPORT LibCDSConfig LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT ${HEADERS_COMPONENT} NAMELINK_ONLY)
+if(BUILD_STATIC)
+install(TARGETS ${CDS_STATIC_LIBRARY} EXPORT LibCDSConfig DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT ${LIBRARIES_COMPONENT})
+endif()
+install(EXPORT LibCDSConfig FILE LibCDSConfig.cmake NAMESPACE LibCDS:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/LibCDS)
 install(DIRECTORY ${PROJECT_SOURCE_DIR}/cds DESTINATION include COMPONENT ${HEADERS_COMPONENT})
 
 if(WITH_TESTS)
@@ -248,3 +263,8 @@ set(CPACK_COMPONENT_GROUP_DEVELOPMENT_DESCRIPTION "All of the tools you'll ever
 set(CPACK_COMPONENT_GROUP_RUNTIME_DESCRIPTION "Only libcds library for runtime")
 
 include(CPack)
+
+string(JOIN " " LIBCDS_PC_CFLAGS ${LIBCDS_PUBLIC_CXX_FLAGS})
+configure_file(libcds.pc.in libcds.pc @ONLY)
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libcds.pc
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
diff --git a/libcds.pc.in b/libcds.pc.in
new file mode 100644
index 0000000..f331f94
--- /dev/null
+++ b/libcds.pc.in
@@ -0,0 +1,10 @@
+prefix=@CMAKE_INSTALL_PREFIX@
+exec_prefix=${prefix}
+libdir=@CMAKE_INSTALL_FULL_LIBDIR@
+includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
+
+Name: libcds
+Description: Concurrent data structures library
+Version: @PROJECT_VERSION@
+Libs: -L${libdir} -lcds
+Cflags: -I${includedir} @LIBCDS_PC_CFLAGS@
-- 
2.54.0

