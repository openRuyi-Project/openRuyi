prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: decNumber
Description: General Decimal Arithmetic library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ldecNumber
Cflags: -I${includedir}/decnumber
