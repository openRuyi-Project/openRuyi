From fd3406067f9a105f4f4f243ce959462787ca33f9 Mon Sep 17 00:00:00 2001
From: CHEN Xuan <chenxuan@iscas.ac.cn>
Date: Sun, 12 Jul 2026 10:00:01 +0800
Subject: [PATCH] Retain NVIDIA Gluon descriptor types

The common native specializer imports the pure-Python NVIDIA
TensorDescriptor class even when only the AMD backend is enabled.
---
 MANIFEST.in | 1 -
 setup.py    | 2 --
 2 files changed, 3 deletions(-)

diff --git a/MANIFEST.in b/MANIFEST.in
index 874be34..bd784ee 100644
--- a/MANIFEST.in
+++ b/MANIFEST.in
@@ -7,7 +7,6 @@ graft lib
 graft python/src
 graft python/test
 graft python/triton
-prune python/triton/experimental/gluon/nvidia
 prune python/triton/experimental/gluon/language/nvidia
 prune python/triton/tools/triton_to_gluon_translater
 graft test
diff --git a/setup.py b/setup.py
index cc4ad5a..ee89ba1 100644
--- a/setup.py
+++ b/setup.py
@@ -671,8 +671,6 @@ def get_packages():
     excludes = []
     if not any(backend.name == "nvidia" for backend in backends):
         excludes.extend([
-            "triton.experimental.gluon.nvidia",
-            "triton.experimental.gluon.nvidia.*",
             "triton.experimental.gluon.language.nvidia",
             "triton.experimental.gluon.language.nvidia.*",
             "triton.tools.triton_to_gluon_translater",
-- 
2.53.0

