From: Peter Bell <peterbell10@openai.com>
Subject: [PATCH] Adapt Triton 3.9.0 to newer LLVM and MLIR

Backport the MLIR dialect assembly settings, FuncOp traits, and LLVM/MLIR
API updates from upstream PR #12236 so Triton 3.9.0 builds against the
newer LLVM revision used by buddy-mlir.
https://github.com/triton-lang/triton/commit/408f1a31f23e976e342e4309cebdb4d4d24392c5

Also pass convergent=false to LLVM::InlineAsmOp::create in GCNAsmFormat.cpp,
which still exists in 3.9.0 (removed on upstream main before #12236).

--- a/include/triton/Dialect/Triton/IR/TritonDialect.td
+++ b/include/triton/Dialect/Triton/IR/TritonDialect.td
@@ -8,6 +8,9 @@ def Triton_Dialect : Dialect {

   let cppNamespace = "::mlir::triton";

+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
+
   let summary = "The Triton IR in MLIR";

   let description = [{
--- a/include/triton/Dialect/Triton/IR/TritonOps.td
+++ b/include/triton/Dialect/Triton/IR/TritonOps.td
@@ -1224,8 +1224,8 @@

 def FuncOp : TT_Op<"func", [
     AffineScope, AutomaticAllocationScope, CallableOpInterface,
-    FunctionOpInterface, IsolatedFromAbove, OpAsmOpInterface,
-    HasParent<"ModuleOp">
+    SymbolName, SymbolVisibility, FunctionOpInterface, IsolatedFromAbove,
+    OpAsmOpInterface, HasParent<"ModuleOp">
 ]> {
   let summary = "An operation with a name containing a single `SSACFG` region";
   let description = [{
