%global srcname tensorboard

Name:           python-%{srcname}
Version:        2.21.0
Release:        %autorelease
Summary:        Visualization toolkit for machine learning experiments
License:        Apache-2.0
URL:            https://github.com/tensorflow/tensorboard
#!RemoteAsset:  sha256:6cf2193326759e9cefe5ef772c935e5b8f15a79093033cddff7e785b30f5bfd9
Source0:        https://github.com/tensorflow/tensorboard/archive/refs/tags/%{version}.tar.gz#/%{srcname}-%{version}.tar.gz
# Upstream release supplies the generated frontend assets and package manifest.
# Python modules are built from Source0; no Python code is copied from the wheel.
#!RemoteAsset:  sha256:7279316dcb6bd5bc391d623dea841531299cde1887310e8133bc34a996d32255
Source1:        https://files.pythonhosted.org/packages/37/4b/cd2eec9642781a8f5b2fb9994e3933a7b259ab18e9d49aeede9b5acf6311/tensorboard-2.21.0-py3-none-any.whl
Source2:        prepare-python.py
BuildArch:      noarch
BuildSystem:    pyproject

# Discover the staged Python namespace and use the system Bleach sanitizer.
Patch2000:      2000-Build-the-Python-package-with-system-Bleach.patch

BuildOption(install):  tensorboard
# These optional Keras/hparams and mesh summary writers import TensorFlow.
BuildOption(check):  -e 'tensorboard.plugins.hparams.api'
BuildOption(check):  -e 'tensorboard.plugins.hparams.summary'
BuildOption(check):  -e 'tensorboard.plugins.mesh.summary'

BuildRequires:  pyproject-rpm-macros
BuildRequires:  pkgconfig(python3)
BuildRequires:  pkgconfig(protobuf)
BuildRequires:  grpc-devel

Provides:       python3-%{srcname} = %{version}-%{release}
%python_provide python3-%{srcname}

%description
TensorBoard visualizes machine learning training metrics, images, audio,
histograms, and model graphs. It reads event files written by TensorFlow,
PyTorch, and other compatible training frameworks.

%generate_buildrequires
%pyproject_buildrequires

%prep -a
%{python3} %{SOURCE2} %{SOURCE1}
cp tensorboard-upstream/pip_package/setup.py .
cp tensorboard-upstream/pip_package/requirements.txt .
cp tensorboard-upstream/pip_package/README.rst .

%build -p
find tensorboard -name '*.proto' -print0 | xargs -0 protoc -I. -I%{_includedir} --python_out=.
protoc -I. -I%{_includedir} --grpc_python_out=. --plugin=protoc-gen-grpc_python=%{_bindir}/grpc_python_plugin tensorboard/data/proto/data_provider.proto

# Match runtime requirements to code generated by the system compilers.
%{python3} %{SOURCE2} --generated-requirements

%files -f %{pyproject_files}
%doc README.md
%license LICENSE
%{_bindir}/tensorboard

%changelog
%autochangelog
