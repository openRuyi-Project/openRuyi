+package version
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"testing"
+)
+
+type versionTransport struct {
+	base *url.URL
+	next http.RoundTripper
+}
+
+func (p versionTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Method != http.MethodGet || req.URL.Scheme != "https" {
+		return nil, fmt.Errorf("unexpected version request: %s %s", req.Method, req.URL)
+	}
+	clone := req.Clone(req.Context())
+	target := *req.URL
+	target.Scheme, target.Host = p.base.Scheme, p.base.Host
+	clone.URL = &target
+	return p.next.RoundTrip(clone)
+}
+
+func TestMain(m *testing.M) {
+	responses := map[string]string{
+		"build.golang.org/?mode=json": `{"builders":["linux-amd64"],"revisions":[{"repo":"go","revision":"0123456789abcdef","date":"2025-05-06T12:00:00Z","branch":"master","author":"Go Authors","desc":"test fixture","results":["ok"]}]}`,
+		"golang.org/dl/?mode=json":    `[{"version":"go1.24.3","stable":true,"files":[{"filename":"go1.24.3.linux-amd64.tar.gz","os":"linux","arch":"amd64","version":"go1.24.3","kind":"archive"}]},{"version":"go1.23.9","stable":true,"files":[{"filename":"go1.23.9.src.tar.gz","version":"go1.23.9","kind":"source"}]}]`,
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, ok := responses[r.Host+r.URL.RequestURI()]
+		if !ok {
+			http.Error(w, "unexpected version request", http.StatusNotFound)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(body))
+	}))
+	base, err := url.Parse(server.URL)
+	if err != nil {
+		panic(err)
+	}
+	original := http.DefaultClient
+	http.DefaultClient = &http.Client{Transport: versionTransport{base: base, next: http.DefaultTransport}}
+	code := m.Run()
+	http.DefaultClient = original
+	server.Close()
+	os.Exit(code)
+}
