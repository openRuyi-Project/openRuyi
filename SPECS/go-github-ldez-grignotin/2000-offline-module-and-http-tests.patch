+package goproxy
+
+import (
+	"archive/zip"
+	"bytes"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"testing"
+)
+
+type proxyTransport struct {
+	base *url.URL
+	next http.RoundTripper
+}
+
+func (p proxyTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Host == "proxy.golang.org" {
+		req = req.Clone(req.Context())
+		target := *req.URL
+		target.Scheme, target.Host = p.base.Scheme, p.base.Host
+		req.URL = &target
+	} else if req.URL.Hostname() != "127.0.0.1" {
+		return nil, fmt.Errorf("unexpected external test request: %s", req.URL)
+	}
+	return p.next.RoundTrip(req)
+}
+
+// Exercise the default proxy URL and the real HTTP client using deterministic
+// protocol responses. The existing unit-test servers still receive requests.
+func TestMain(m *testing.M) {
+	var archive bytes.Buffer
+	w := zip.NewWriter(&archive)
+	files := map[string]string{
+		"github.com/ldez/grignotin@v0.1.0/go.mod": "module github.com/ldez/grignotin\n\ngo 1.13\n",
+		"github.com/ldez/grignotin@v0.1.0/doc.go": "package grignotin\n",
+	}
+	for name, body := range files {
+		entry, err := w.Create(name)
+		if err != nil {
+			panic(err)
+		}
+		if _, err := entry.Write([]byte(body)); err != nil {
+			panic(err)
+		}
+	}
+	if err := w.Close(); err != nil {
+		panic(err)
+	}
+	responses := map[string]string{
+		"/github.com/ldez/grignotin/@v/v0.1.0.zip":                                  archive.String(),
+		"/github.com/ldez/grignotin/@v/v0.1.0.mod":                                  "module github.com/ldez/grignotin\n\ngo 1.13\n",
+		"/github.com/hashicorp/consul/api/@v/list":                                  "v1.2.3\nv1.2.4\nv1.2.5\n",
+		"/github.com/ijc25/!gotty/@v/a8b993ba6abdb0e0c12b0125c603323a71c7790c.info": `{"Version":"v0.0.0-20170406111628-a8b993ba6abd","Time":"2017-04-06T11:16:28Z"}`,
+		"/golang.org/x/lint/@latest":                                                `{"Version":"v0.0.0-20241112194109-818c5a804067","Time":"2024-11-12T19:41:09Z"}`,
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, ok := responses[r.URL.RequestURI()]
+		if !ok || r.Method != http.MethodGet {
+			http.Error(w, "unexpected proxy request", http.StatusNotFound)
+			return
+		}
+		_, _ = w.Write([]byte(body))
+	}))
+	base, err := url.Parse(server.URL)
+	if err != nil {
+		panic(err)
+	}
+	original := http.DefaultTransport
+	http.DefaultTransport = proxyTransport{base: base, next: original}
+	code := m.Run()
+	http.DefaultTransport = original
+	server.Close()
+	os.Exit(code)
+}
+
+func checkSourceArchive(t *testing.T, raw []byte) {
+	t.Helper()
+	archive, err := zip.NewReader(bytes.NewReader(raw), int64(len(raw)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(archive.File) != 2 {
+		t.Fatalf("expected two module files, got %d", len(archive.File))
+	}
+}
