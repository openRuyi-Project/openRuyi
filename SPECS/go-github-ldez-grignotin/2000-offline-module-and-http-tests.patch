+package metago
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+)
+
+type metaTransport struct {
+	base *url.URL
+	next http.RoundTripper
+}
+
+func (p metaTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Method != http.MethodGet || req.URL.Scheme != "https" || req.URL.RawQuery != "go-get=1" {
+		return nil, fmt.Errorf("unexpected metadata request: %s %s", req.Method, req.URL)
+	}
+	clone := req.Clone(req.Context())
+	target := *req.URL
+	target.Scheme, target.Host = p.base.Scheme, p.base.Host
+	clone.URL = &target
+	return p.next.RoundTrip(clone)
+}
+
+func TestMain(m *testing.M) {
+	// Representative go-get responses, including go-source, go-import and
+	// hosts without metadata. Preserve every original host/path assertion.
+	responses := map[string]string{
+		"github.com/stretchr/testify":       `<html><head></head><body></body></html>`,
+		"k8s.io/api":                        `<meta name="go-import" content="k8s.io/api git https://github.com/kubernetes/api">`,
+		"go.elastic.co/apm":                 `<meta name="go-source" content="go.elastic.co/apm https://github.com/elastic/apm-agent-go https://github.com/elastic/apm-agent-go/tree/master{/dir} https://github.com/elastic/apm-agent-go/blob/master{/dir}/{file}#L{line}">`,
+		"gopkg.in/DataDog/dd-trace-go.v1":   `<meta name="go-import" content="gopkg.in/DataDog/dd-trace-go.v1 git https://github.com/DataDog/dd-trace-go">`,
+		"mvdan.cc/xurls/v2":                 `<meta name="go-import" content="mvdan.cc/xurls git https://github.com/mvdan/xurls">`,
+		"gotest.tools":                      `<meta name="go-import" content="gotest.tools git https://github.com/gotestyourself/gotest.tools">`,
+		"gocloud.dev":                       `<meta name="go-import" content="gocloud.dev git https://github.com/google/go-cloud">`,
+		"google.golang.org/appengine":       `<meta name="go-import" content="google.golang.org/appengine git https://github.com/golang/appengine">`,
+		"golang.org/x/crypto":               `<meta name="go-import" content="golang.org/x/crypto git https://go.googlesource.com/crypto">`,
+		"google.golang.org/grpc":            `<meta name="go-import" content="google.golang.org/grpc git https://github.com/grpc/grpc-go">`,
+		"launchpad.net/gocheck":             `<meta name="go-import" content="launchpad.net/gocheck bzr https://launchpad.net/~niemeyer/gocheck/trunk">`,
+		"code.gitea.io/sdk/gitea":           `<meta name="go-import" content="code.gitea.io/sdk/gitea git https://gitea.com/gitea/go-sdk">`,
+		"code.gitea.io/gitea":               `<meta name="go-import" content="code.gitea.io/gitea git https://github.com/go-gitea/gitea">`,
+		"gitlab.com/golang-commonmark/html": `<html><head></head><body></body></html>`,
+		"bitbucket.org/dtolpin/wigp":        `<html><head></head><body></body></html>`,
+	}
+	// Map the transport's original authority and request path to a fixture.
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		key := strings.TrimSuffix(r.Host+r.URL.Path, "/")
+		if r.Host == "mvdan.cc" && r.URL.Path == "/xurls" {
+			key = "mvdan.cc/xurls/v2"
+		}
+		body, ok := responses[key]
+		if !ok {
+			http.Error(w, "unexpected metadata path", http.StatusNotFound)
+			return
+		}
+		_, _ = w.Write([]byte(body))
+	}))
+	base, err := url.Parse(server.URL)
+	if err != nil {
+		panic(err)
+	}
+	original := http.DefaultClient
+	http.DefaultClient = &http.Client{Transport: metaTransport{base: base, next: http.DefaultTransport}}
+	code := m.Run()
+	http.DefaultClient = original
+	server.Close()
+	os.Exit(code)
+}
