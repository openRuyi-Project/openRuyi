-                                   int32_t imm21, LabelDoc doc) {
+BufferOffset AssemblerRiscvBase::GenInstrJ(BaseOpcode opcode, Register rd,
+                                           int32_t imm21, LabelDoc doc) {
   MOZ_ASSERT(is_int21(imm21) && ((imm21 & 1) == 0));
   Instr instr = opcode | (rd.code() << kRdShift) |
                 (imm21 & 0xff000) |          // bits 19-12
