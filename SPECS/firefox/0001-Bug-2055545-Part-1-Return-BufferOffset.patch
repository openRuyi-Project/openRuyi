+                                   Register rd, Register rs1, int16_t imm12) {
   MOZ_ASSERT(is_uint3(funct3) && (is_uint12(imm12) || is_int12(imm12)));
   Instr instr = opcode | (rd.code() << kRdShift) | (funct3 << kFunct3Shift) |
                 (rs1.code() << kRs1Shift) | (imm12 << kImm12Shift);
-  return emit(instr);
+  emit(instr);
 }
 
