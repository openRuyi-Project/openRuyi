From 316706c2088444c463dbe0e0ae74372b1fdde536 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 11 Nov 2026 01:22:21 +0800
Subject: [PATCH] Normalize the Tokio major-version requirement

Use the equivalent caret range 1.0.0 so the RPM capability generator resolves the Tokio major-1 provider and its macros and sync features.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index a720de9..23c56bc 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -52,7 +52,7 @@ path = "src/lib.rs"
 version = "0.3.70"
 
 [dependencies.tokio]
-version = "1.x.x"
+version = "1.0.0"
 
 [dependencies.tokio_with_wasm_proc]
 version = "0.8.8"
-- 
2.54.0

