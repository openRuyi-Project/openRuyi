From cff42c80b943a0519aca55d499382d63adb99ad1 Mon Sep 17 00:00:00 2001
From: misaka00251 <liuxin@iscas.ac.cn>
Date: Tue, 21 Jul 2026 17:42:08 +0800
Subject: [PATCH] Remove pinned tracing-subscriber version

---
 Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index 6b3e55b..43c9d97 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -90,7 +90,7 @@ tracing = "0.1"
 tracing-log = "0.2"
 # Newer versions render ANSI escape codes, causing CLI errors to be ugly
 # See also https://github.com/tokio-rs/tracing/issues/3369
-tracing-subscriber = { version = "=0.3.19", features = ["env-filter"] }
+tracing-subscriber = { version = "0.3.19", features = ["env-filter"] }
 url = "2.4"
 wait-timeout = "0.2"
 xz2 = "0.1.3"
-- 
2.55.0

