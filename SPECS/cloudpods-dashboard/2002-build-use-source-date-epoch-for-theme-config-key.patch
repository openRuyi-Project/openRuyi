From 2a2047688a66af0e24b54265bc8363f92326d8fe Mon Sep 17 00:00:00 2001
From: wangyf0611 <wangyufeng@iscas.ac.cn>
Date: Sun, 14 Sep 2026 13:38:00 +0800
Subject: [PATCH] build: use SOURCE_DATE_EPOCH for theme config key

webpack-theme-color-replacer generates a random global configuration key for
production builds.  That random value changes the vendor chunk and its content
hash even when the source and toolchain are unchanged.

Use SOURCE_DATE_EPOCH as the suffix when a reproducible build explicitly sets
it.  Keep the dependency's existing random behavior for ordinary production
builds and its fixed development key.

Signed-off-by: wangyf0611 <wangyufeng@iscas.ac.cn>
---
 node_modules/webpack-theme-color-replacer/src/Handler.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/node_modules/webpack-theme-color-replacer/src/Handler.js b/node_modules/webpack-theme-color-replacer/src/Handler.js
index a54100a..24d3f7e 100644
--- a/node_modules/webpack-theme-color-replacer/src/Handler.js
+++ b/node_modules/webpack-theme-color-replacer/src/Handler.js
@@ -16,7 +16,8 @@ module.exports = class Handler {
             isJsUgly: !(process.env.NODE_ENV === 'development' || process.argv.find(arg => arg.match(/\bdev/))),
             // 开发环境，由于webpack有代码编译缓存，会导致configVar不匹配先前编译缓存的代码，而出现win()[WP_THEME_CONFIG]为空。故开发环境固定使用tc_cfg_dev。
             // 如需要多个插件并存可显式传入options.configVer
-            configVar: process.env.NODE_ENV === 'development' ? 'tc_cfg_dev' : ('tc_cfg_' + Math.random().toString().slice(2)),
+            configVar: process.env.NODE_ENV === 'development' ? 'tc_cfg_dev' :
+                ('tc_cfg_' + (process.env.SOURCE_DATE_EPOCH || Math.random().toString().slice(2))),
         }, options);
         this.assetsExtractor = new AssetsExtractor(this.options)
     }
-- 
