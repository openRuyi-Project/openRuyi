From 2636facd7fc8f576726c765accdfcd1ca732eea1 Mon Sep 17 00:00:00 2001
From: Kyle Bader <kbader@ibm.com>
Date: Sat, 17 Oct 2026 12:00:00 +0000
Subject: [PATCH] test/osd: build MockPeeringListener.cc into
 pg_backend_test_fixture

OsdTestFixture owns a MockPeeringListener, and PGBackendTestFixture.cc
destroys it. Only ec_peering_test_fixture built MockPeeringListener.cc,
so unittest_backend_basics did not link (no vtable for
MockPeeringListener). Build it in pg_backend_test_fixture, which every
user of ec_peering_test_fixture also links.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Kyle Bader <kbader@ibm.com>
---
 src/test/osd/CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/test/osd/CMakeLists.txt b/src/test/osd/CMakeLists.txt
index a809cccc411..d4935002858 100644
--- a/src/test/osd/CMakeLists.txt
+++ b/src/test/osd/CMakeLists.txt
@@ -123,6 +123,9 @@ target_link_libraries(unittest_peeringstate osd os global ${CMAKE_DL_LIBS} ${BLK
 add_library(pg_backend_test_fixture OBJECT
   PGBackendTestFixture.cc
   MockPGBackendListener.cc
+  # OsdTestFixture owns a MockPeeringListener, so its vtable is needed
+  # wherever the fixture is
+  MockPeeringListener.cc
   MockStore.cc
   ObjectTracker.cc
 )
@@ -131,7 +134,6 @@ target_link_libraries(pg_backend_test_fixture osd os global GTest::GTest)
 # ec_peering_test_fixture: object library for ECPeeringTestFixture implementation
 add_library(ec_peering_test_fixture OBJECT
   ECPeeringTestFixture.cc
-  MockPeeringListener.cc
 )
 target_link_libraries(ec_peering_test_fixture osd os global GTest::GTest)
 
