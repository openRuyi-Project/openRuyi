From a38640d0d7e625d550a0a748a39049968f89cc80 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 03:07:03 +0800
Subject: [PATCH] Support linking the PDF filters and their tests against a
 system PDFium

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 RepositoryExternal.mk                      |  8 ++++++++
 config_host.mk.in                          |  3 +++
 configure.ac                               | 11 ++++++-----
 vcl/CppunitTest_vcl_graphic_test.mk        |  4 ++--
 vcl/CppunitTest_vcl_pdf_encryption.mk      |  2 +-
 vcl/CppunitTest_vcl_pdfexport.mk           |  2 +-
 vcl/CppunitTest_vcl_pdfexport2.mk          |  2 +-
 vcl/CppunitTest_vcl_pdfium_library_test.mk |  2 +-
 vcl/Library_vcl.mk                         |  4 ++--
 vcl/Module_vcl.mk                          |  4 ++--
 10 files changed, 27 insertions(+), 15 deletions(-)

diff --git a/RepositoryExternal.mk b/RepositoryExternal.mk
index d417eed..8ead3b0 100644
--- a/RepositoryExternal.mk
+++ b/RepositoryExternal.mk
@@ -4396,6 +4396,12 @@ $(call gb_LinkTarget_use_libraries,$(1),clew)
 endef
 
 ifneq ($(ENABLE_PDFIUM),)
+ifneq ($(SYSTEM_PDFIUM),)
+define gb_LinkTarget__use_pdfium
+$(call gb_LinkTarget_set_include,$(1),$(PDFIUM_CFLAGS) $$(INCLUDE))
+$(call gb_LinkTarget_add_libs,$(1),$(PDFIUM_LIBS))
+endef
+else
 define gb_LinkTarget__use_pdfium
 $(call gb_LinkTarget_set_include,$(1),\
        -I$(gb_UnpackedTarball_workdir)/pdfium/public \
@@ -4408,6 +4414,8 @@ $(eval $(call gb_Helper_register_libraries_for_install,OOOLIBS,ooo,\
        pdfium \
 ))
 
+endif # SYSTEM_PDFIUM
+
 ifneq ($(SYSTEM_AFDKO),)
 
 else # !SYSTEM_AFDKO
diff --git a/config_host.mk.in b/config_host.mk.in
index 67440ae..b07f5f8 100644
--- a/config_host.mk.in
+++ b/config_host.mk.in
@@ -230,6 +230,9 @@ export ENABLE_PAGEIN=@ENABLE_PAGEIN@
 export ENABLE_PCH=@ENABLE_PCH@
 export ENABLE_PDFIMPORT=@ENABLE_PDFIMPORT@
 export ENABLE_PDFIUM=@ENABLE_PDFIUM@
+export SYSTEM_PDFIUM=@SYSTEM_PDFIUM@
+export PDFIUM_CFLAGS=@PDFIUM_CFLAGS@
+export PDFIUM_LIBS=@PDFIUM_LIBS@
 export ENABLE_POPPLER=@ENABLE_POPPLER@
 export ENABLE_QT5=@ENABLE_QT5@
 export ENABLE_QT6=@ENABLE_QT6@
diff --git a/configure.ac b/configure.ac
index 4641ba7..0df7fd0 100644
--- a/configure.ac
+++ b/configure.ac
@@ -13133,14 +13133,13 @@ AC_MSG_CHECKING([whether to build PDFium])
 ENABLE_PDFIUM=
 if test \( -z "$enable_pdfium" -a "$ENABLE_PDFIMPORT" = "TRUE" \) -o "$enable_pdfium" = yes; then
     AC_MSG_RESULT([yes])
-    ENABLE_PDFIUM=TRUE
-    BUILD_TYPE="$BUILD_TYPE PDFIUM"
+    libo_CHECK_SYSTEM_MODULE([pdfium],[PDFIUM],[pdfium])
 else
     AC_MSG_RESULT([no])
 fi
 AC_SUBST(ENABLE_PDFIUM)
 
-if test "$ENABLE_PDFIUM" = "TRUE"; then
+if test "$ENABLE_PDFIUM" = "TRUE" -a "$SYSTEM_PDFIUM" != "TRUE"; then
     AC_MSG_CHECKING([which OpenJPEG library to use])
     if test "$with_system_openjpeg" = "yes"; then
         SYSTEM_OPENJPEG2=TRUE
@@ -13168,8 +13167,10 @@ if test "$ENABLE_PDFIUM" = "TRUE"; then
         AC_MSG_RESULT([internal])
     fi
 
-    # Only used by the pdf import code that uses pdfium
-    # which doesn't currently have --with-system support
+fi
+
+if test "$ENABLE_PDFIUM" = "TRUE"; then
+    # The PDF import code also needs AFDKO.
     if test "$ENABLE_PDFIMPORT" = "TRUE"; then
         AC_DEFINE(HAVE_FEATURE_AFDKO)
         AC_MSG_CHECKING([which AFDKO to use])
diff --git a/vcl/CppunitTest_vcl_graphic_test.mk b/vcl/CppunitTest_vcl_graphic_test.mk
index 33e818e..e41943f 100644
--- a/vcl/CppunitTest_vcl_graphic_test.mk
+++ b/vcl/CppunitTest_vcl_graphic_test.mk
@@ -15,13 +15,13 @@ $(eval $(call gb_CppunitTest_add_exception_objects,vcl_graphic_test, \
     vcl/qa/cppunit/GraphicDescriptorTest \
     vcl/qa/cppunit/GraphicFormatDetectorTest \
     vcl/qa/cppunit/GraphicNativeMetadataTest \
-    $(if $(filter PDFIUM,$(BUILD_TYPE)),vcl/qa/cppunit/VectorGraphicSearchTest) \
+    $(if $(ENABLE_PDFIUM),vcl/qa/cppunit/VectorGraphicSearchTest) \
     vcl/qa/cppunit/BinaryDataContainerTest \
 ))
 
 $(eval $(call gb_CppunitTest_use_externals,vcl_graphic_test, \
     boost_headers \
-    $(if $(filter PDFIUM,$(BUILD_TYPE)),pdfium) \
+    $(if $(ENABLE_PDFIUM),pdfium) \
 ))
 ifeq ($(TLS),NSS)
 $(eval $(call gb_CppunitTest_use_externals,vcl_graphic_test,\
diff --git a/vcl/CppunitTest_vcl_pdf_encryption.mk b/vcl/CppunitTest_vcl_pdf_encryption.mk
index a0910e2..c6a2635 100644
--- a/vcl/CppunitTest_vcl_pdf_encryption.mk
+++ b/vcl/CppunitTest_vcl_pdf_encryption.mk
@@ -36,7 +36,7 @@ $(eval $(call gb_CppunitTest_use_libraries,vcl_pdf_encryption, \
 $(eval $(call gb_CppunitTest_use_externals,vcl_pdf_encryption, \
 	boost_headers \
 	libxml2 \
-	$(if $(filter PDFIUM,$(BUILD_TYPE)),pdfium) \
+	$(if $(ENABLE_PDFIUM),pdfium) \
 ))
 
 ifeq ($(TLS),NSS)
diff --git a/vcl/CppunitTest_vcl_pdfexport.mk b/vcl/CppunitTest_vcl_pdfexport.mk
index 59afa7f..2aa8744 100644
--- a/vcl/CppunitTest_vcl_pdfexport.mk
+++ b/vcl/CppunitTest_vcl_pdfexport.mk
@@ -33,7 +33,7 @@ $(eval $(call gb_CppunitTest_use_libraries,vcl_pdfexport, \
 $(eval $(call gb_CppunitTest_use_externals,vcl_pdfexport, \
 	boost_headers \
 	libxml2 \
-	$(if $(filter PDFIUM,$(BUILD_TYPE)),pdfium) \
+	$(if $(ENABLE_PDFIUM),pdfium) \
 ))
 
 $(eval $(call gb_CppunitTest_use_sdk_api,vcl_pdfexport))
diff --git a/vcl/CppunitTest_vcl_pdfexport2.mk b/vcl/CppunitTest_vcl_pdfexport2.mk
index 1e3c3dc..304db66 100644
--- a/vcl/CppunitTest_vcl_pdfexport2.mk
+++ b/vcl/CppunitTest_vcl_pdfexport2.mk
@@ -34,7 +34,7 @@ $(eval $(call gb_CppunitTest_use_libraries,vcl_pdfexport2, \
 $(eval $(call gb_CppunitTest_use_externals,vcl_pdfexport2, \
 	boost_headers \
 	libxml2 \
-	$(if $(filter PDFIUM,$(BUILD_TYPE)),pdfium) \
+	$(if $(ENABLE_PDFIUM),pdfium) \
 ))
 
 $(eval $(call gb_CppunitTest_set_include,vcl_pdfexport2,\
diff --git a/vcl/CppunitTest_vcl_pdfium_library_test.mk b/vcl/CppunitTest_vcl_pdfium_library_test.mk
index 37acb11..19bc13e 100644
--- a/vcl/CppunitTest_vcl_pdfium_library_test.mk
+++ b/vcl/CppunitTest_vcl_pdfium_library_test.mk
@@ -31,7 +31,7 @@ $(eval $(call gb_CppunitTest_use_libraries,vcl_pdfium_library_test, \
 
 $(eval $(call gb_CppunitTest_use_externals,vcl_pdfium_library_test, \
 	boost_headers \
-	$(if $(filter PDFIUM,$(BUILD_TYPE)),pdfium) \
+	$(if $(ENABLE_PDFIUM),pdfium) \
 ))
 
 $(eval $(call gb_CppunitTest_use_sdk_api,vcl_pdfium_library_test))
diff --git a/vcl/Library_vcl.mk b/vcl/Library_vcl.mk
index 17cf238..5ad99e2 100644
--- a/vcl/Library_vcl.mk
+++ b/vcl/Library_vcl.mk
@@ -755,7 +755,7 @@ $(eval $(call gb_Library_add_exception_objects,vcl,\
         $(vcl_headless_code) \
         $(vcl_headless_freetype_code) \
     ) \
-    vcl/source/pdf/$(if $(filter PDFIUM,$(BUILD_TYPE)),,Dummy)PDFiumLibrary \
+    vcl/source/pdf/$(if $(ENABLE_PDFIUM),,Dummy)PDFiumLibrary \
 ))
 
 # fontconfig depends on expat for static builds
@@ -767,7 +767,7 @@ $(eval $(call gb_Library_use_externals,vcl,\
         fontconfig \
         freetype \
     ) \
-    $(if $(filter PDFIUM,$(BUILD_TYPE)),pdfium) \
+    $(if $(ENABLE_PDFIUM),pdfium) \
     $(if $(filter AFDKO,$(BUILD_TYPE)),afdko libxml2) \
 ))
 
diff --git a/vcl/Module_vcl.mk b/vcl/Module_vcl.mk
index fdc5ec5..6bc431f 100644
--- a/vcl/Module_vcl.mk
+++ b/vcl/Module_vcl.mk
@@ -257,7 +257,7 @@ $(eval $(call gb_Module_add_check_targets,vcl,\
     CppunitTest_vcl_blocklistparser_test \
     CppunitTest_vcl_type_serializer_test \
     CppunitTest_vcl_animation \
-    $(call gb_Helper_optional, PDFIUM, \
+    $(if $(ENABLE_PDFIUM), \
         CppunitTest_vcl_pdfium_library_test) \
     $(if $(filter SKIA,$(BUILD_TYPE)), \
         CppunitTest_vcl_skia) \
@@ -303,7 +303,7 @@ $(eval $(call gb_Module_add_slowcheck_targets,vcl,\
 ))
 endif
 
-ifneq (,$(filter PDFIUM,$(BUILD_TYPE)))
+ifneq (,$(ENABLE_PDFIUM))
 $(eval $(call gb_Module_add_slowcheck_targets,vcl,\
     CppunitTest_vcl_pdfexport \
     CppunitTest_vcl_pdfexport2 \
-- 
2.54.0

