From 805bbea1f854ecdbc52a9533154c90681a634971 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Thu, 5 Nov 2026 08:03:38 +0800
Subject: [PATCH] bridges: synchronize RISC-V instructions after writing vtable
 slots

The bridge emits executable code at run time. A data fence orders memory accesses but leaves instruction caches stale. Use the compiler cache-flush builtin for the generated range so that the kernel also synchronizes execution across harts.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 bridges/source/cpp_uno/gcc3_linux_riscv64/cpp2uno.cxx | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/bridges/source/cpp_uno/gcc3_linux_riscv64/cpp2uno.cxx b/bridges/source/cpp_uno/gcc3_linux_riscv64/cpp2uno.cxx
index 731eb12..24ec2e7 100644
--- a/bridges/source/cpp_uno/gcc3_linux_riscv64/cpp2uno.cxx
+++ b/bridges/source/cpp_uno/gcc3_linux_riscv64/cpp2uno.cxx
@@ -641,9 +641,11 @@ unsigned char* codeSnippet(unsigned char* code, sal_Int32 functionIndex, sal_Int
 }
 }
 
-void bridges::cpp_uno::shared::VtableFactory::flushCode(unsigned char const*, unsigned char const*)
+void bridges::cpp_uno::shared::VtableFactory::flushCode(unsigned char const* begin,
+                                                     unsigned char const* end)
 {
-    asm volatile("fence" :::);
+    __builtin___clear_cache(const_cast<char*>(reinterpret_cast<const char*>(begin)),
+                            const_cast<char*>(reinterpret_cast<const char*>(end)));
 }
 
 struct bridges::cpp_uno::shared::VtableFactory::Slot
