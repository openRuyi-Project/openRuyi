From ac59ed69d45683086feb344e1bfd4d7b542c42c6 Mon Sep 17 00:00:00 2001
From: Xisco Fauli <xiscofauli@libreoffice.org>
Date: Mon, 19 Oct 2026 21:51:41 +0200
Subject: [PATCH] box2d: upgrade to 3.2.0

Downloaded https://github.com/erincatto/box2d/archive/refs/tags/v3.2.0.tar.gz

Change-Id: Icaa610aa48e24a7c33b74101b75450d210e08db3
Reviewed-on: https://gerrit.libreoffice.org/c/core/+/212645
Tested-by: Jenkins
Reviewed-by: Xisco Fauli <xiscofauli@libreoffice.org>
---
 slideshow/source/engine/box2dtools.cxx | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/slideshow/source/engine/box2dtools.cxx b/slideshow/source/engine/box2dtools.cxx
index c3ddac0..b164099 100644
--- a/slideshow/source/engine/box2dtools.cxx
+++ b/slideshow/source/engine/box2dtools.cxx
@@ -307,7 +307,11 @@ void box2DWorld::createStaticFrameAroundSlide(const ::basegfx::B2DVector& rSlide
 
     b2ChainDef aChainDef = b2DefaultChainDef();
     aChainDef.points = aEdgePoints;
+#if BOX2D_CHECK_VERSION(3, 2)
+    aChainDef.pointCount = 4;
+#else
     aChainDef.count = 4;
+#endif
     aChainDef.isLoop = true;
     b2CreateChain(aBody, &aChainDef);
 #else
@@ -1001,8 +1005,12 @@ void box2DBody::setDensityAndRestitution(const double fDensity, const double fRe
 #endif
         b2Shape_SetRestitution(aShapeId, static_cast<float>(fRestitution));
     }
-    // without resetting the massdata of the body, density change won't take effect
+        // without resetting the massdata of the body, density change won't take effect
+#if BOX2D_CHECK_VERSION(3, 2)
+    b2Body_UpdateMassFromShapes(*mpBox2DBody);
+#else
     b2Body_ApplyMassFromShapes(*mpBox2DBody);
+#endif
 #else
     // density and restitution have to be set for each fixture of the body individually
     for (b2Fixture* pFixture = mpBox2DBody->GetFixtureList(); pFixture;
