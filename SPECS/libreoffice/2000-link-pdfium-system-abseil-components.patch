From 984a92a5029c105a7dc83abb009799b3141d6a28 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 11 Nov 2026 23:13:54 +0800
Subject: [PATCH] Link PDFium against the Abseil components it uses

PDFium 8073 uses absl::Cleanup and absl::flat_hash_set in addition to absl::InlinedVector. Detect their pkg-config modules so the system Abseil link flags include the hash-table implementation.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 configure.ac | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index ff39173..7cf1f9a 100644
--- a/configure.ac
+++ b/configure.ac
@@ -13159,7 +13159,7 @@ if test "$ENABLE_PDFIUM" = "TRUE"; then
         AC_MSG_RESULT([external])
         SYSTEM_ABSEIL=TRUE
         AC_LANG_PUSH([C++])
-        PKG_CHECK_MODULES(ABSEIL, absl_bad_optional_access absl_bad_variant_access absl_inlined_vector )
+        PKG_CHECK_MODULES(ABSEIL, absl_cleanup absl_flat_hash_set absl_inlined_vector )
         AC_LANG_POP([C++])
         ABSEIL_CFLAGS=$(printf '%s' "$ABSEIL_CFLAGS" | sed -e "s/-I/${ISYSTEM?}/g")
         FilterLibs "${ABSEIL_LIBS}"
-- 
2.54.0

