From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sun Yuechi <sunyuechi@iscas.ac.cn>
Date: Mon, 5 Oct 2026 00:21:15 -0700
Subject: [PATCH] python/mcp: make the spdk-mcp entry point callable

spdk.mcp:server resolves to the server module, not a function, so the
installed spdk-mcp script fails with "'module' object is not
callable". Point it at a main() that runs the server.

Change-Id: I6cea401a06ae6fbac97d970aac4d26a9e59fc858
Signed-off-by: Sun Yuechi <sunyuechi@iscas.ac.cn>
---
 python/pyproject.toml     | 2 +-
 python/spdk/mcp/server.py | 7 ++++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/python/pyproject.toml b/python/pyproject.toml
index 596b124bb..e898021ac 100644
--- a/python/pyproject.toml
+++ b/python/pyproject.toml
@@ -44,7 +44,7 @@ dependencies = []
 spdk-rpc = "spdk.spdk_rpc:main"
 spdk-sma = "spdk.spdk_sma:main"
 spdk-cli = "spdk.spdk_cli:main"
-spdk-mcp = "spdk.mcp:server"
+spdk-mcp = "spdk.mcp.server:main"
 
 [project.optional-dependencies]
 sma = [
diff --git a/python/spdk/mcp/server.py b/python/spdk/mcp/server.py
index 7e1013b90..fc7155546 100644
--- a/python/spdk/mcp/server.py
+++ b/python/spdk/mcp/server.py
@@ -31,5 +31,10 @@ for func in bdev_functions:
     update_wrapper(newfunc, func)
     mcp.add_tool(newfunc)
 
-if __name__ == "__main__":
+
+def main():
     mcp.run()
+
+
+if __name__ == "__main__":
+    main()
-- 
2.56.0

