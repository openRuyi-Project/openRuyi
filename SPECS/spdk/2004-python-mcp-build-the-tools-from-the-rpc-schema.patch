 "../scripts/rpc.py" = "spdk/spdk_rpc.py"
 "../scripts/sma.py" = "spdk/spdk_sma.py"
 "../scripts/spdkcli.py" = "spdk/spdk_cli.py"
+"../schema/schema.yaml" = "spdk/schema.yaml"
 
 [tool.ruff]
