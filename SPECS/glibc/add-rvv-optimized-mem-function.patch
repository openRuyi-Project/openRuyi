+    vsetvli t1, zero, e8, m4, ta, ma
+
+    .p2align 3
+.Lloop:
+    vle8.v   v8, (a0)
+    vmseq.vi v0, v8, 0
+    vfirst.m t3, v0
+    bgez     t3, .Lfound
+
