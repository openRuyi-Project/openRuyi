+    vse8.v  v0, (tmp1)
+    
+    addi    tmp1, dstend, -32
+    vse8.v  v0, (tmp1)
+    
+    blez    count, 2f
+
+    .p2align 3
+1:  addi    dst, dst, 64
+    vse8.v  v0, (dst)
+    addi    tmp1, dst, 32
+    vse8.v  v0, (tmp1)
+    addi    count, count, -64
+    bgtz    count, 1b
+2:  ret
+
+    .p2align 3
+L_no_zva:
+    sub     count, dstend, dst
+    addi    count, count, -(64 + 32)
+    blez    count, L_tail64
+
+    .p2align 3
+1:  addi    tmp1, dst, 32
+    vse8.v  v0, (tmp1)
+   
+    addi    tmp1, dst, 64
+    vse8.v  v0, (tmp1)
+    
+    addi    dst, dst, 64
+    addi    count, count, -64
+    bgtz    count, 1b
+
+L_tail64:
+    addi    tmp1, dstend, -64
+    vse8.v  v0, (tmp1)
+   
+    addi    tmp1, dstend, -32
+    vse8.v  v0, (tmp1)
+    
