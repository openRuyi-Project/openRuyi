+#include <sys/asm.h>
+
+#ifndef RAWMEMCHR
+# define RAWMEMCHR rawmemchr
+#endif
+           
+.text
+.p2align 2
+ENTRY (RAWMEMCHR)
+	# a0 = str 
+	# a1 = c
+	beqz	a1, L(do_strlen)
+	li	a2, -1
+	tail	HIDDEN_JUMPTARGET (memchr)	
+
+L(do_strlen):
+	
+	addi	sp, sp, -16
+	REG_S	ra, 8(sp)
+	REG_S	s0, 0(sp)   
+
+	mv	s0, a0     
+	call	HIDDEN_JUMPTARGET (strlen)
+
+	add	a0, s0, a0
+
+	REG_L	s0, 0(sp)
+	REG_L	ra, 8(sp)   
+	addi	sp, sp, 16  
+
+	ret
+
+END(RAWMEMCHR)
