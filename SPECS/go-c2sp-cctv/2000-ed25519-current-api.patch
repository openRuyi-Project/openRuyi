 	p := (&edwards25519.Point{}).ScalarBaseMult(s)
 	if multByPrimeOrder(p).Equal(I) != 1 {
 		t.Fail()
diff --git a/ed25519/reencoded25519.go b/ed25519/reencoded25519.go
index d3f7e3b..4b58755 100644
--- a/ed25519/reencoded25519.go
+++ b/ed25519/reencoded25519.go
@@ -37,7 +37,10 @@ func ReencodedVerify(publicKey, message, sig []byte) bool {
 	kh.Write(message)
 	hramDigest := make([]byte, 0, sha512.Size)
 	hramDigest = kh.Sum(hramDigest)
-	k := new(edwards25519.Scalar).SetUniformBytes(hramDigest)
+	k, err := new(edwards25519.Scalar).SetUniformBytes(hramDigest)
+	if err != nil {
+		return false
+	}
 
 	// [8][S]B = [8]R + [8][k]A --> [8]([k](-A) + [S]B) = [8]R
 	minusA := new(edwards25519.Point).Negate(A)
