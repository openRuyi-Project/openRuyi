# Run Python with the same environment the SGLang launcher uses, without a
# server command line.

set -e
unset PYTHONHOME PYTHONPATH
unset LD_LIBRARY_PATH LD_PRELOAD
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1
exec @PYTHON3@ -sP "$@"
