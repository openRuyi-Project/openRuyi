# Start the SGLang server from the distribution Python environment.  Inherited
# interpreter and loader settings are dropped so the run resolves packages from
# the installed site-packages tree only.

set -e
unset PYTHONHOME PYTHONPATH
unset LD_LIBRARY_PATH LD_PRELOAD
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1
exec @PYTHON3@ -sP @LIBEXEC@/sglang "$@"
