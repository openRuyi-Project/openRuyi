-// The v1 default is true.
-func ParseBytesWithLooseRFC4648(v bool) Options {
-	if v {
-		return jsonflags.ParseBytesWithLooseRFC4648 | 1
-	} else {
-		return jsonflags.ParseBytesWithLooseRFC4648 | 0
-	}
-}
