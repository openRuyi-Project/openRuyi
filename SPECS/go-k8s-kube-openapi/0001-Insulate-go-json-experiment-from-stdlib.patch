-			Delim('{'), "a", float64(2), Delim('}'),
-			Delim(']')}},
-		{CaseName: Name(""), json: `{"obj": {"a": 1}}`, expTokens: []any{
-			Delim('{'), "obj", Delim('{'), "a", float64(1), Delim('}'),
