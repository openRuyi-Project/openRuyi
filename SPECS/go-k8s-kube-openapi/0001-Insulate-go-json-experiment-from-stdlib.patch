-// Reference encoding, jsonv2, and jsontext packages to assist pkgsite
-// in being able to hotlink references to those packages.
-var (
-	_ encoding.TextMarshaler
-	_ encoding.TextUnmarshaler
-	_ jsonv2.Options
-	_ jsontext.Options
-)
