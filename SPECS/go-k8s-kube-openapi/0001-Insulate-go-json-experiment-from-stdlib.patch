-
-		// streaming tokens with intermittent Decode()
-		{CaseName: Name(""), json: `{ "a": 1 }`, expTokens: []any{
-			Delim('{'), "a",
-			decodeThis{float64(1)},
-			Delim('}')}},
-		{CaseName: Name(""), json: ` [ { "a" : 1 } ] `, expTokens: []any{
