%global crate_name du-dust

Name:           dust
Version:        1.2.7
Release:        %autorelease
Summary:        A more intuitive version of du
License:        Apache-2.0
URL:            https://github.com/bootandy/dust
#!RemoteAsset:  sha256:f03ee50cf880da85dce8d1bc8e005c906498fb4754512998823f6ef9ae7d997c
Source0:        https://static.crates.io/crates/%{crate_name}/%{version}/download#/%{name}-%{version}.tar.gz
BuildSystem:    rust

# Remove the unused sysinfo dependency, which pulls an unavailable macOS-only crate.
Patch2000:      2000-remove-unused-sysinfo-dependency.patch

# Skip test_apparent_size: its expected indentation is tied to a different terminal formatter.
BuildOption(check):  --skip test_apparent_size

BuildRequires:  rust
BuildRequires:  cargo
BuildRequires:  rust-rpm-macros
BuildRequires:  crate(chrono-0.4/default) >= 0.4.0
BuildRequires:  crate(clap-4) >= 4.4.0
BuildRequires:  crate(clap-4/default) >= 4.0.0
BuildRequires:  crate(clap-4/derive) >= 4.4.0
BuildRequires:  crate(clap-complete-4) >= 4.4.0
BuildRequires:  crate(clap-mangen-0.3) >= 0.3.0
BuildRequires:  crate(config-file-0.2/default) >= 0.2.0
BuildRequires:  crate(ctrlc-3/default) >= 3.0.0
BuildRequires:  crate(filesize-0.2/default) >= 0.2.0
BuildRequires:  crate(lscolors-0.21/default) >= 0.21.0
BuildRequires:  crate(nu-ansi-term-0.50/default) >= 0.50.0
BuildRequires:  crate(portable-atomic-1/default) >= 1.4.0
BuildRequires:  crate(rayon-1/default) >= 1.0.0
BuildRequires:  crate(regex-1/default) >= 1.0.0
BuildRequires:  crate(rustc-hash-2/default) >= 2.0.0
BuildRequires:  crate(serde-1/default) >= 1.0.0
BuildRequires:  crate(serde-1/derive) >= 1.0.0
BuildRequires:  crate(serde-json-1/default) >= 1.0.0
BuildRequires:  crate(stfu8-0.2/default) >= 0.2.0
BuildRequires:  crate(terminal-size-0.4/default) >= 0.4.0
BuildRequires:  crate(thousands-0.2/default) >= 0.2.0
BuildRequires:  crate(unicode-width-0.2/default) >= 0.2.0
BuildRequires:  crate(winapi-util-0.1/default) >= 0.1.0
BuildRequires:  crate(assert-cmd-2/default) >= 2.0.0
BuildRequires:  crate(tempfile-3/default) >= 3.0.0

%description
dust is a more intuitive version of du. It shows disk usage with a
clear tree view and sensible defaults.

%install
# Install the binary and the completion and man-page files generated by build.rs.
install -Dpm0755 target/release/dust %{buildroot}%{_bindir}/dust
install -Dpm0644 man-page/dust.1 %{buildroot}%{_mandir}/man1/dust.1
install -Dpm0644 completions/dust.bash %{buildroot}%{_datadir}/bash-completion/completions/dust
install -Dpm0644 completions/dust.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/dust.fish
install -Dpm0644 completions/_dust %{buildroot}%{_datadir}/zsh/site-functions/_dust
install -Dpm0644 completions/dust.elv %{buildroot}%{_datadir}/elvish/lib/dust

%files
%doc README.md
%license LICENSE
%{_bindir}/dust
%{_mandir}/man1/dust.1*
%{_datadir}/bash-completion/completions/dust
%{_datadir}/elvish/lib/dust
%{_datadir}/fish/vendor_completions.d/dust.fish
%{_datadir}/zsh/site-functions/_dust

%changelog
%autochangelog
