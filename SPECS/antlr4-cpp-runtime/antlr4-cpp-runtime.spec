Name:           antlr4-cpp-runtime
Version:        4.13.2
Release:        %autorelease
Summary:        C++ runtime library for ANTLR 4 parsers
License:        BSD-3-Clause
URL:            https://www.antlr.org/
VCS:            git:https://github.com/antlr/antlr4.git
#!RemoteAsset:  sha256:9f18272a9b32b622835a3365f850dd1063d60f5045fb1e12ce475ae6e18a35bb
Source0:        https://github.com/antlr/antlr4/archive/refs/tags/%{version}.tar.gz#/antlr4-%{version}.tar.gz
BuildSystem:    cmake

# Fix the undeclared std::chrono::high_resolution_clock on toolchains
# whose standard library headers do not include <chrono> transitively.
# https://github.com/antlr/antlr4/commit/df4d68c09cdef73e023b8838a8bc7ca4dff1d1de
Patch0:         0001-include-chrono-for-high-resolution-clock.patch
# Upstream test configuration fails in offline builds when FetchContent
# tries to download GoogleTest. Use the system GoogleTest CMake package.
Patch2000:      2000-use-system-gtest-for-runtime-tests.patch
# CMake installation fails with "file INSTALL cannot find" because it
# looks for LICENSE.txt under runtime/Cpp/ while the file is at the
# source root. Remove the CMake rule and let RPM install the license.
Patch2001:      2001-use-rpm-license-installation.patch

BuildOption(prep):  -n antlr4-%{version}
BuildOption(conf):  -S runtime/Cpp
BuildOption(conf):  -DANTLR4_INSTALL=ON
BuildOption(conf):  -DANTLR_BUILD_CPP_TESTS=ON
BuildOption(conf):  -DANTLR_BUILD_SHARED=ON
BuildOption(conf):  -DANTLR_BUILD_STATIC=OFF

BuildRequires:  cmake
BuildRequires:  cmake(GTest)
BuildRequires:  gcc-c++

%description
The ANTLR C++ runtime provides token streams, error handling and parse
tree classes for parsers generated by ANTLR 4.

%package        devel
Summary:        C++ headers and CMake targets for the ANTLR runtime
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    devel
Development files for compiling generated parsers and lexers against
the ANTLR C++ runtime.

%files
%license LICENSE.txt
%{_datadir}/doc/libantlr4/
%{_libdir}/libantlr4-runtime.so.*

%files devel
%{_includedir}/antlr4-runtime/
%{_libdir}/libantlr4-runtime.so
%{_libdir}/cmake/antlr4-*/

%changelog
%autochangelog
