From bf9698b9d309a7ded2feffcebd704cb2f11e473a Mon Sep 17 00:00:00 2001
From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Mon, 17 Aug 2026 02:18:09 +0800
Subject: [PATCH] api/auth/gcp: use cloud IAM credential types

Recent cloud.google.com/go/iam clients accept protobuf request types from their credentialspb package. Use those types directly so the auth helper remains compatible with current cloud IAM releases.

Signed-off-by: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
---
 api/auth/gcp/gcp.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/api/auth/gcp/gcp.go b/api/auth/gcp/gcp.go
index ce6e47a..b7dc006 100644
--- a/api/auth/gcp/gcp.go
+++ b/api/auth/gcp/gcp.go
@@ -14,8 +14,8 @@ import (
 
 	"cloud.google.com/go/compute/metadata"
 	credentials "cloud.google.com/go/iam/credentials/apiv1"
+	credentialspb "cloud.google.com/go/iam/credentials/apiv1/credentialspb"
 	"github.com/hashicorp/vault/api"
-	credentialspb "google.golang.org/genproto/googleapis/iam/credentials/v1"
 )
 
 type GCPAuth struct {
-- 
