-
-      if(EXISTS "${LOCAL_URL}")
-        cmake_path(ABSOLUTE_PATH LOCAL_URL)
-        set(DEP_URL_${ONNXRUNTIME_DEP_NAME} "${LOCAL_URL}")
-      endif()
-    endif()
-  endif()
-endforeach()
