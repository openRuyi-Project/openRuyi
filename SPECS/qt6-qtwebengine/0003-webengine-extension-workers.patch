diff --git a/tests/auto/widgets/extensions/resources/localized_worker_ext/service_worker.js b/tests/auto/widgets/extensions/resources/localized_worker_ext/service_worker.js
new file mode 100644
index 0000000..6cb8702
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/localized_worker_ext/service_worker.js
@@ -0,0 +1,7 @@
+// Evaluated at the top level of the worker, before any event handler runs.
+const greeting = chrome.i18n.getMessage("greeting")
+chrome.runtime.onMessage.addListener((message, _, sendResponse) => {
+    if (message === "ping")
+        sendResponse(greeting)
+    return true;
+})
diff --git a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
index d070f1e..7c6f0e7 100644
--- a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
+++ b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
@@ -43,6 +43,7 @@ private Q_SLOTS:
     void loadInstalledExtensions();
     void serviceWorkerMessaging();
     void webAccessibleResource();
+    void serviceWorkerLocalization();
     void anOffscreenDocumentCanBeCreated();
 
 private:
@@ -458,5 +459,22 @@ void tst_QWebEngineExtension::webAccessibleResource()
     QVERIFY(evaluateJavaScriptSync(m_page, "window.scriptRan").toBool());
 }
 
+void tst_QWebEngineExtension::serviceWorkerLocalization()
+{
+    // chrome.i18n.getMessage() is a synchronous call into the browser. A worker that calls it at
+    // its top level cannot finish evaluating, and so never starts, unless the browser answers.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "localized_worker_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    QCOMPARE(extension.name(), "localized worker"_L1);
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(QUrl("qrc:///resources/index.html"));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QTRY_COMPARE(evaluateJavaScriptSync(m_page, "document.getElementById('testNode').textContent"),
+                 "hello from the worker"_L1);
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
 #include "tst_qwebengineextension.moc"
