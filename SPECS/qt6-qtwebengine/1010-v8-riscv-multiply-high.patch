From 7c405ae0da48c68a2d558cbbc8fe38f5377f60b1 Mon Sep 17 00:00:00 2001
From: Kasper Lund <kasperl@rivosinc.com>
Date: Mon, 8 Sep 2025 13:58:37 +0200
Subject: [PATCH] [riscv][maglev] Fix mulh usage in maglev

Before this change, we would use mul.w on 64-bit platforms before
shifting down the bits. The top 32 bits would only be the sign.

Change-Id: I9afc5234c461dda649be893f96af8d2b5b27acff
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/6918970
Reviewed-by: Florian Loitsch <floitsch@rivosinc.com>
Commit-Queue: Kasper Lund <kasperl@rivosinc.com>
Cr-Commit-Position: refs/heads/main@{#102320}
---
 src/maglev/riscv/maglev-ir-riscv.cc | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/3rdparty/chromium/v8/src/maglev/riscv/maglev-ir-riscv.cc b/src/3rdparty/chromium/v8/src/maglev/riscv/maglev-ir-riscv.cc
index 567012d3fdb1..f440bf388b15 100644
--- a/src/3rdparty/chromium/v8/src/maglev/riscv/maglev-ir-riscv.cc
+++ b/src/3rdparty/chromium/v8/src/maglev/riscv/maglev-ir-riscv.cc
@@ -338,8 +338,13 @@ void Int32MultiplyOverflownBits::GenerateCode(MaglevAssembler* masm,
   Register out = ToRegister(result());
 
   // TODO(leszeks): peephole optimise multiplication by a constant.
-  __ Mul32(out, left, right);
-  __ srai(out, out, 32);
+#ifdef V8_TARGET_ARCH_RISCV64
+  __ Mulh32(out, left, right);
+#elif V8_TARGET_ARCH_RISCV32
+  __ Mulh(out, left, right);
+#else
+  UNREACHABLE();
+#endif
 }
 
 void Int32Divide::SetValueLocationConstraints() {
