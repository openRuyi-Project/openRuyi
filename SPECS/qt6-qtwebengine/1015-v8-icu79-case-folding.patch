+++ b/src/3rdparty/chromium/v8/src/regexp/regexp-compiler-tonode.cc
@@ -1528,6 +1528,7 @@ void CharacterRange::AddCaseEquivalents(Isolate* isolate, Zone* zone,
   icu::UnicodeSet already_added(others);
   others.removeAll(RegExpCaseFolding::IgnoreSet());
   others.closeOver(USET_CASE_INSENSITIVE);
+  others.remove(0x10000, 0x10ffff);
   others.removeAll(RegExpCaseFolding::IgnoreSet());
   others.removeAll(already_added);
 
diff --git a/src/3rdparty/chromium/v8/src/regexp/regexp-compiler.cc b/src/3rdparty/chromium/v8/src/regexp/regexp-compiler.cc
index 4526949..8558541 100644
