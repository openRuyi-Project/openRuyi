+++ b/src/3rdparty/chromium/v8/src/regexp/regexp-compiler.cc
@@ -794,6 +794,7 @@ int GetCaseIndependentLetters(Isolate* isolate, base::uc16 character,
   set.add(character);
   set = set.closeOver(unicode ? USET_SIMPLE_CASE_INSENSITIVE
                               : USET_CASE_INSENSITIVE);
+  if (!unicode) set.remove(0x10000, 0x10ffff);
 
   UChar32 canon = 0;
   if (in_special_add_set && !unicode) {
diff --git a/src/3rdparty/chromium/v8/src/regexp/regexp-parser.cc b/src/3rdparty/chromium/v8/src/regexp/regexp-parser.cc
index 61bcfbe..b6c0d04 100644
--- a/src/3rdparty/chromium/v8/src/regexp/regexp-parser.cc
+++ b/src/3rdparty/chromium/v8/src/regexp/regexp-parser.cc
@@ -9,6 +9,7 @@
 #include "src/regexp/regexp-ast.h"
 #include "src/regexp/regexp-macro-assembler.h"
 #include "src/regexp/regexp.h"
+#include "src/regexp/special-case.h"
 #include "src/strings/char-predicates-inl.h"
 #include "src/utils/ostreams.h"
 #include "src/utils/utils.h"
@@ -155,6 +156,10 @@ void RegExpTextBuilder::FlushText() {
 
 void RegExpTextBuilder::AddCharacter(base::uc16 c) {
   FlushPendingSurrogate();
+  if (NeedsDesugaringForIgnoreCase(c)) {
+    AddClassRangesForDesugaring(c);
+    return;
+  }
   if (characters_ == nullptr) {
     characters_ = zone()->New<ZoneList<base::uc16>>(4, zone());
   }
@@ -237,12 +242,16 @@ bool RegExpTextBuilder::NeedsDesugaringForUnicode(RegExpClassRanges* cc) {
   return false;
 }
 
-// We only use this for characters made of surrogate pairs.  All other
-// characters outside of character classes are made case independent in the
-// code generation.
+// Desugar supplementary characters with case equivalents and BMP characters
+// with supplementary equivalents. Other atoms are folded during code
+// generation.
 bool RegExpTextBuilder::NeedsDesugaringForIgnoreCase(base::uc32 c) {
 #ifdef V8_INTL_SUPPORT
   if (IsUnicodeMode() && ignore_case()) {
+    if (c <= unibrow::Utf16::kMaxNonSurrogateCharCode) {
+      return RegExpCaseFolding::HasSupplementaryEquivalents(
+          static_cast<base::uc16>(c));
+    }
     icu::UnicodeSet set(c, c);
     set.closeOver(USET_CASE_INSENSITIVE);
     set.removeAllStrings();
diff --git a/src/3rdparty/chromium/v8/src/regexp/special-case.h b/src/3rdparty/chromium/v8/src/regexp/special-case.h
index 753c923..b6cbd95 100644
--- a/src/3rdparty/chromium/v8/src/regexp/special-case.h
+++ b/src/3rdparty/chromium/v8/src/regexp/special-case.h
@@ -7,6 +7,7 @@
 
 #ifdef V8_INTL_SUPPORT
 #include "src/base/logging.h"
+#include "src/base/strings.h"
 #include "src/common/globals.h"
 
 #include "unicode/uchar.h"
@@ -71,11 +72,20 @@ namespace internal {
 // another character. Characters that match no other characters in
 // their equivalence class are added to IgnoreSet. Characters that
 // match at least one other character are added to SpecialAddSet.
+// Supplementary code points are ignored for non-unicode matching, which
+// compares UTF-16 code units. SupplementaryEquivalentsSet contains the BMP
+// characters whose Unicode case closure includes supplementary code points.
 
 class RegExpCaseFolding final : public AllStatic {
  public:
   static const icu::UnicodeSet& IgnoreSet();
   static const icu::UnicodeSet& SpecialAddSet();
+  static const icu::UnicodeSet& SupplementaryEquivalentsSet();
+
+  // Whether c has supplementary Unicode case equivalents.
+  static bool HasSupplementaryEquivalents(base::uc16 c) {
+    return SupplementaryEquivalentsSet().contains(c);
+  }
 
   // This implements ECMAScript 2020 21.2.2.8.2 (Runtime Semantics:
   // Canonicalize) step 3, which is used to determine whether
