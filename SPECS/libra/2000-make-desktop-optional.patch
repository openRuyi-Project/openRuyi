Subject: Make the desktop user interface optional
Upstream: https://github.com/libra-tools/libra
Upstream-Status: Pending

Allow the CLI and SQLite storage to build independently of the GPUI
toolkit. Keep the default feature set for upstream desktop builds.

diff --git a/Cargo.toml b/Cargo.toml
index 86bbac3..e49f629 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -12,7 +12,8 @@ categories = ["command-line-utilities", "development-tools"]
 readme = "README.md"

 [features]
-default = ["storage-sqlite"]
+default = ["storage-sqlite", "desktop-ui"]
+desktop-ui = ["dep:gpui", "dep:gpui_platform", "dep:ely-gpui-component"]
 storage-sqlite = []
 storage-redb = ["storage-queue", "dep:redb", "dep:postcard", "dep:crc32c"]
 storage-queue = ["dep:postcard", "dep:crc32c"]
@@ -108,11 +109,10 @@ dirs = "6.0.0"
 axum = "0.8.9"
 tempfile = "3.27.0"
 fastcdc = { version = "=3.2.1", optional = true }
-# Desktop window (`libra ui`). Ely pins this GPUI snapshot; the window is part
-# of every ordinary build, so these dependencies are not feature-gated.
-gpui = { package = "gpui-pre", version = "=0.3.10" }
-gpui_platform = { package = "gpui-pre-platform", version = "=0.3.10", features = ["font-kit", "wayland", "x11"] }
-ely-gpui-component = { git = "https://github.com/ELY-Open-Source/Ely-GPUI-Components", rev = "dd727f4dc3ff26c5aa0b233ac23cac7b5f41d6f6" }
+# Desktop window (`libra ui`). Keep enabled by default for desktop builds.
+gpui = { package = "gpui-pre", version = "=0.3.10", optional = true }
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.10", features = ["font-kit", "wayland", "x11"], optional = true }
+ely-gpui-component = { git = "https://github.com/ELY-Open-Source/Ely-GPUI-Components", rev = "dd727f4dc3ff26c5aa0b233ac23cac7b5f41d6f6", optional = true }

 # Async stream helpers
 tokio-stream = { version = "0.1.18", features = ["sync"] }
