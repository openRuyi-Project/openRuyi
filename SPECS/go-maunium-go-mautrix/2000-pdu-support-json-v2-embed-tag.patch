From: Kimmy <yucheng.or@isrc.iscas.ac.cn>
Subject: [PATCH] pdu: preserve unknown members with Go 1.27 JSON embedding

Go 1.27 encoding/json/v2 recognizes embed instead of unknown. Retain both
tags so unknown object members remain embedded rather than adding an
Unknown field, which corrupts event hashes and signatures.

--- a/federation/pdu/pdu.go
+++ b/federation/pdu/pdu.go
@@ -56,7 +56,7 @@
 type InternalMeta struct {
 	EventID  id.EventID     `json:"event_id,omitempty"`
 	Rejected bool           `json:"rejected,omitempty"`
-	Extra    map[string]any `json:",unknown"`
+	Extra    map[string]any `json:",unknown,embed"`
 }
 
 type PDU struct {
@@ -75,7 +75,7 @@
 	Unsigned       jsontext.Value                 `json:"unsigned,omitzero"`
 	InternalMeta   InternalMeta                   `json:"-"`
 
-	Unknown jsontext.Value `json:",unknown"`
+	Unknown jsontext.Value `json:",unknown,embed"`
 
 	// Deprecated legacy fields
 	DeprecatedPrevState  jsontext.Value `json:"prev_state,omitzero"`
@@ -88,7 +88,7 @@
 type Hashes struct {
 	SHA256 jsonbytes.UnpaddedBytes `json:"sha256"`
 
-	Unknown jsontext.Value `json:",unknown"`
+	Unknown jsontext.Value `json:",unknown,embed"`
 }
 
 func (pdu *PDU) ToClientEvent(roomVersion id.RoomVersion) (*event.Event, error) {
--- a/federation/pdu/v1.go
+++ b/federation/pdu/v1.go
@@ -72,7 +72,7 @@
 	Type           string                         `json:"type"`
 	Unsigned       jsontext.Value                 `json:"unsigned,omitzero"`
 
-	Unknown jsontext.Value `json:",unknown"`
+	Unknown jsontext.Value `json:",unknown,embed"`
 
 	// Deprecated legacy fields
 	DeprecatedPrevState  jsontext.Value `json:"prev_state,omitzero"`
