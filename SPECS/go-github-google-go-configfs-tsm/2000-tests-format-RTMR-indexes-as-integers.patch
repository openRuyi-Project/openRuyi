From d0ef5b85a0fe344b2159992777918f9d99661731 Mon Sep 17 00:00:00 2001
From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Fri, 16 Oct 2026 14:02:21 +0800
Subject: [PATCH] rtmr: format register indexes as decimal integers

Register indexes are integers, not quoted strings. Use the decimal verb in both failure messages so current Go vet accepts the tests.
---
 rtmr/rtmr_test.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/rtmr/rtmr_test.go b/rtmr/rtmr_test.go
index 5e8b35b..6c5333d 100644
--- a/rtmr/rtmr_test.go
+++ b/rtmr/rtmr_test.go
@@ -122,7 +122,7 @@ func TestGetRtmrDigestAndExtendDigest(t *testing.T) {
 		t.Fatalf("GetDigest(%d) failed: %v", rtmrIndex, err)
 	}
 	if !bytes.Equal(digest1.Digest, initRtmrValue) {
-		t.Fatalf("rtmr%q does not have the all-zero initial value %q", rtmrIndex, digest1.Digest)
+		t.Fatalf("rtmr%d does not have the all-zero initial value %q", rtmrIndex, digest1.Digest)
 	}
 	// ExtendDigest
 	err = ExtendDigest(client, rtmrIndex, sha384Hash[:])
@@ -135,6 +135,6 @@ func TestGetRtmrDigestAndExtendDigest(t *testing.T) {
 		t.Fatalf("GetDigest(%d) failed: %v", rtmrIndex, err)
 	}
 	if !bytes.Equal(digest2.Digest, extendRtmrValue) {
-		t.Fatalf("rtmr%q does not match the expected value: got %q, want %q", rtmrIndex, digest2.Digest, extendRtmrValue)
+		t.Fatalf("rtmr%d does not match the expected value: got %q, want %q", rtmrIndex, digest2.Digest, extendRtmrValue)
 	}
 }
-- 
