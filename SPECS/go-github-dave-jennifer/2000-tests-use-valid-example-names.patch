From 279037080b6410e9dec2d1de1931282ff407f7bd Mon Sep 17 00:00:00 2001
From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Mon, 19 Oct 2026 13:45:46 +0800
Subject: [PATCH] tests: use valid example names for current Go vet

Use lowercase example suffixes for scenarios that do not name exported identifiers. Associate the dot-import example with File.ImportAlias. Keep all example bodies and expected output unchanged.
---
 jen/examples_test.go | 22 +++++++++++-----------
 1 file changed, 11 insertions(+), 11 deletions(-)

diff --git a/jen/examples_test.go b/jen/examples_test.go
index f1d825a..bfb6b29 100644
--- a/jen/examples_test.go
+++ b/jen/examples_test.go
@@ -7,14 +7,14 @@ import (
 	. "github.com/dave/jennifer/jen"
 )
 
-func ExampleGenericsTypesFuncEmpty() {
+func Example_genericsTypesFuncEmpty() {
 	c := Func().Id("F").TypesFunc(func(group *Group) {}).Params().Block()
 	fmt.Printf("%#v", c)
 	// Output:
 	// func F() {}
 }
 
-func ExampleGenericsTypesFuncNull() {
+func Example_genericsTypesFuncNull() {
 	c := Func().Id("F").TypesFunc(func(group *Group) {
 		group.Null()
 	}).Params().Block()
@@ -23,21 +23,21 @@ func ExampleGenericsTypesFuncNull() {
 	// func F() {}
 }
 
-func ExampleGenericsTypesEmpty() {
+func Example_genericsTypesEmpty() {
 	c := Func().Id("F").Types().Params().Block()
 	fmt.Printf("%#v", c)
 	// Output:
 	// func F() {}
 }
 
-func ExampleGenericsTypesNull() {
+func Example_genericsTypesNull() {
 	c := Func().Id("F").Types(Null()).Params().Block()
 	fmt.Printf("%#v", c)
 	// Output:
 	// func F() {}
 }
 
-func ExampleGenericsTypesDefinition() {
+func Example_genericsTypesDefinition() {
 	c := Func().Id("Keys").Types(
 		Id("K").Comparable(),
 		Id("V").Any(),
@@ -49,14 +49,14 @@ func ExampleGenericsTypesDefinition() {
 	// func Keys[K comparable, V any](m map[K]V) []K {}
 }
 
-func ExampleGenericsTypesUsage() {
+func Example_genericsTypesUsage() {
 	c := Return(Id("Keys").Types(Int(), String()).Call(Id("m")))
 	fmt.Printf("%#v", c)
 	// Output:
 	// return Keys[int, string](m)
 }
 
-func ExampleGenericsUnion() {
+func Example_genericsUnion() {
 	c := Type().Id("PredeclaredSignedInteger").Interface(
 		Union(Int(), Int8(), Int16(), Int32(), Int64()),
 	)
@@ -67,7 +67,7 @@ func ExampleGenericsUnion() {
 	// }
 }
 
-func ExampleGenericsApproximate() {
+func Example_genericsApproximate() {
 	c := Type().Id("AnyString").Interface(
 		Op("~").String(),
 	)
@@ -78,7 +78,7 @@ func ExampleGenericsApproximate() {
 	// }
 }
 
-func ExampleCaseBug() {
+func Example_caseBug() {
 	c := Switch(Id("a")).Block(
 		Case(Lit(1)).Block(
 			Var().Id("i").Int(),
@@ -259,7 +259,7 @@ func ExampleFile_ImportAlias() {
 	// }
 }
 
-func ExampleFile_ImportAliasDot() {
+func ExampleFile_ImportAlias_dot() {
 	f := NewFile("main")
 
 	// package a should be a dot-import
@@ -1681,7 +1681,7 @@ func ExampleNewFilePathName() {
 	// }
 }
 
-func ExampleFile_HeaderAndPackageComments() {
+func ExampleFile_headerAndPackageComments() {
 	f := NewFile("c")
 	f.CanonicalPath = "d.e/f"
 	f.HeaderComment("Code generated by...")
