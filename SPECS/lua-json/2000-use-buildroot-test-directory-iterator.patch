From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: openRuyi Package Maintainers <packagers@openruyi.cn>
Date: Tue, 18 Aug 2026 20:30:00 +0800
Subject: [PATCH] tests: provide a buildroot directory iterator

LuaFileSystem is not currently available in the openRuyi repositories.  The
regression suite only uses it to enumerate its fixture directories, so provide
a test-local module backed by find(1).  This keeps every upstream fixture and
assertion enabled while avoiding a runtime dependency on a module unrelated to
the library under test.
---
 tests/lfs/init.lua | 51 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 tests/lfs/init.lua

diff --git a/tests/lfs/init.lua b/tests/lfs/init.lua
new file mode 100644
index 0000000..aa66f11
--- /dev/null
+++ b/tests/lfs/init.lua
@@ -0,0 +1,51 @@
+local io = require("io")
+local string = require("string")
+
+local M = {}
+
+local function shell_quote(value)
+    return "'" .. string.gsub(value, "'", "'\\''") .. "'"
+end
+
+function M.attributes(path, attribute)
+    local command = "test -d " .. shell_quote(path) .. " && printf directory"
+    local pipe = assert(io.popen(command, "r"))
+    local mode = pipe:read("*a")
+    local ok, reason, status = pipe:close()
+
+    if not ok then
+        if reason == "exit" and status == 1 then
+            return nil
+        end
+        error("directory check failed for " .. path .. ": " ..
+              tostring(reason) .. " " .. tostring(status))
+    end
+
+    local result = { mode = mode }
+    if attribute then
+        return result[attribute]
+    end
+    return result
+end
+
+function M.dir(path)
+    local command = "find " .. shell_quote(path) ..
+                    " -mindepth 1 -maxdepth 1 -printf '%f\\n' | LC_ALL=C sort"
+    local pipe = assert(io.popen(command, "r"))
+    local closed = false
+
+    return function()
+        local entry = pipe:read("*l")
+        if entry == nil and not closed then
+            local ok, reason, status = pipe:close()
+            closed = true
+            if not ok then
+                error("directory enumeration failed for " .. path .. ": " ..
+                      tostring(reason) .. " " .. tostring(status))
+            end
+        end
+        return entry
+    end
+end
+
+return M
-- 
