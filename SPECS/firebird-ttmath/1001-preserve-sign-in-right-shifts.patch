From ee6827def1558abbe977c42e7247a2d257100817 Mon Sep 17 00:00:00 2001
From: AlexPeshkoff <alexander.peshkoff@gmail.com>
Date: Mon, 19 Jun 2023 15:46:58 +0000
Subject: [PATCH] Fix for #7603: BIN_SHR on INT128 does not apply sign
 extension

Upstream-Commit: https://github.com/FirebirdSQL/firebird/commit/3da900bf178eb45500dd774e6d22c99683e47d25
Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 ttmath/ttmathint.h | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/ttmath/ttmathint.h b/ttmath/ttmathint.h
index 8ad0189..f9971bd 100644
--- a/ttmath/ttmathint.h
+++ b/ttmath/ttmathint.h
@@ -1797,6 +1797,24 @@ public:
 	}
 
 
+	Int<value_size> operator>>(int move) const
+	{
+	Int<value_size> temp( *this );
+
+		temp.Rcr(move, UInt<value_size>::IsTheHighestBitSet() ? 1 : 0);
+
+	return temp;
+	}
+
+
+	UInt<value_size> & operator>>=(int move)
+	{
+		UInt<value_size>::Rcr(move, UInt<value_size>::IsTheHighestBitSet() ? 1 : 0);
+
+	return *this;
+	}
+
+
 
 	/*!
 	*
-- 
2.54.0

