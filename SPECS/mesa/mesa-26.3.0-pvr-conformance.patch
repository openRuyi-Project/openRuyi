Advertise it as conformant.

Signed-off-by: Icenowy Zheng <zhengxingda@iscas.ac.cn>
---
 src/imagination/vulkan/pvr_physical_device.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/imagination/vulkan/pvr_physical_device.c b/src/imagination/vulkan/pvr_physical_device.c
index 16cb03b6d6d..70454e3d65a 100644
--- a/src/imagination/vulkan/pvr_physical_device.c
+++ b/src/imagination/vulkan/pvr_physical_device.c
@@ -1137,6 +1137,7 @@ static bool pvr_device_is_conformant(const struct pvr_device_info *info)
    switch (bvnc) {
    case PVR_BVNC_PACK(36, 52, 104, 182):
    case PVR_BVNC_PACK(36, 53, 104, 796):
+   case PVR_BVNC_PACK(36, 56, 104, 183):
       return true;
 
    default:
